#!/usr/bin/env bash
#
# Snell + VLESS-Reality + AnyTLS management script for githubh01/snell
#
# SCRIPT-ID: snell-vless-reality-anytls-manager
# The line above is how this script recognises its own copies on disk. It is
# deliberately language-independent so translating the interface can never
# break shortcut installation or the old-file cleanup.
#
# This script is self-contained by design:
# - no remote shell execution
# - no self-update from another repository
# - no telemetry or phone-home behavior
# - Snell binaries are downloaded only from https://dl.nssurge.com/snell/

