show_bbr_status() {
    local cc
    local qdisc
    local module_state="not loaded"

    cc="$(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null || true)"
    qdisc="$(sysctl -n net.core.default_qdisc 2>/dev/null || true)"

    if lsmod 2>/dev/null | awk '{print $1}' | grep -qx 'tcp_bbr'; then
        module_state="loaded"
    elif modinfo tcp_bbr >/dev/null 2>&1; then
        module_state="available"
    fi

    echo
    info "BBR 状态"
    echo "tcp_bbr module: ${module_state}"
    echo "tcp_congestion_control: ${cc:-unknown}"
    echo "default_qdisc: ${qdisc:-unknown}"
}

enable_bbr() {
    local confirm
    local conf="/etc/sysctl.conf"
    local current_cc
    local current_qdisc

    require_root

    show_bbr_status
    echo
    current_cc="$(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null || true)"
    current_qdisc="$(sysctl -n net.core.default_qdisc 2>/dev/null || true)"
    if [ "${current_cc}" = "bbr" ] && [ "${current_qdisc}" = "fq" ]; then
        ok "BBR 已在生效，无需改动。"
        read -rp "Ensure BBR is persisted in ${conf}? [y/N]: " confirm
        [[ "${confirm}" =~ ^[Yy]$ ]] || return 0
    else
        warn "将修改 ${conf} 并执行 sysctl -p 来启用 BBR。"
        read -rp "Enable BBR now? [y/N]: " confirm
        [[ "${confirm}" =~ ^[Yy]$ ]] || return 0
    fi

    if ! modprobe tcp_bbr 2>/dev/null; then
        warn "modprobe 加载 tcp_bbr 失败。内核可能不支持 BBR，或已内置。"
    fi

    if [ -e "${conf}" ] && [ ! -f "${conf}" ]; then
        die "${conf} exists but is not a regular file."
    fi

    if [ ! -e "${conf}" ]; then
        : > "${conf}" || die "Cannot create ${conf}."
        chmod 0644 "${conf}" 2>/dev/null || true
    else
        cp -a "${conf}" "${conf}.bak.$(date +%Y%m%d%H%M%S)" 2>/dev/null || true
    fi

    sed -i '/^[[:space:]]*net.core.default_qdisc[[:space:]]*=/d' "${conf}"
    sed -i '/^[[:space:]]*net.ipv4.tcp_congestion_control[[:space:]]*=/d' "${conf}"

    {
        echo ""
        echo "# Enable BBR congestion control"
        echo "net.core.default_qdisc = fq"
        echo "net.ipv4.tcp_congestion_control = bbr"
    } >> "${conf}"

    sysctl -p "${conf}" >/dev/null || warn "sysctl -p 执行失败，请检查内核支持和 ${conf}。"

    show_bbr_status

    if [ "$(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null || true)" = "bbr" ]; then
        ok "BBR 已启用。"
    else
        warn "BBR 尚未生效，可能需要重启或更新内核。"
    fi
}


sing_box_arch() {
    case "$(uname -m)" in
        x86_64|amd64) echo "amd64" ;;
        aarch64|arm64) echo "arm64" ;;
        armv7l|armv7) echo "armv7" ;;
        *)
            fail_step "architecture check" \
                "sing-box builds are not published for $(uname -m) by this script." \
                "- Supported: x86_64/amd64, aarch64/arm64, armv7l."
            return 1
            ;;
    esac
}

sing_box_latest_version() {
    local version

    version="$(curl -fsSL --connect-timeout 10 https://api.github.com/repos/SagerNet/sing-box/releases/latest 2>/dev/null | grep '"tag_name":' | sed -E 's/.*"([^"]+)".*/\1/' || true)"
    [ -n "${version}" ] || return 1
    printf '%s' "${version}"
}

# Downloads sing-box to an explicit destination and proves the result is a
# working binary before returning. Callers must check the return value.
install_sing_box_binary() {
    local dest="$1"
    local version
    local version_num
    local arch
    local url
    local name
    local tmpdir
    local rc=0

    if [ -z "${dest}" ]; then
        fail_step "sing-box install" "Internal error: destination path is required."
        return 1
    fi

    install_anytls_packages || return 1
    mkdir -p "$(dirname "${dest}")"

    if ! version="$(sing_box_latest_version)"; then
        fail_step "sing-box version lookup" \
            "Could not read the latest release tag from api.github.com." \
            "- The server may not reach api.github.com (DNS, firewall, or rate limit).
- Try again in a few minutes if you hit the GitHub API rate limit." \
            "curl -fsSL https://api.github.com/repos/SagerNet/sing-box/releases/latest"
        return 1
    fi

    if ! arch="$(sing_box_arch)"; then
        return 1
    fi

    version_num="${version#v}"
    name="sing-box-${version_num}-linux-${arch}"
    url="https://github.com/SagerNet/sing-box/releases/download/${version}/${name}.tar.gz"
    tmpdir="$(mktemp -d)"

    info "正在下载 sing-box ${version}（${arch}）..."
    warn "下载源：${url}"

    if ! download_to "${url}" "${tmpdir}/sing-box.tar.gz" "sing-box"; then
        rm -rf "${tmpdir}"
        return 1
    fi

    if ! tar xzf "${tmpdir}/sing-box.tar.gz" -C "${tmpdir}" 2>/dev/null; then
        rm -rf "${tmpdir}"
        fail_step "sing-box extract" \
            "Could not extract ${name}.tar.gz" \
            "- The download may be corrupt; run the option again."
        return 1
    fi

    if [ ! -f "${tmpdir}/${name}/sing-box" ]; then
        rm -rf "${tmpdir}"
        fail_step "sing-box extract" \
            "sing-box was not found inside the archive (expected ${name}/sing-box)." \
            "- The upstream archive layout may have changed."
        return 1
    fi

    install -m 0755 "${tmpdir}/${name}/sing-box" "${dest}" || rc=1
    rm -rf "${tmpdir}"

    if [ "${rc}" -ne 0 ] || [ ! -x "${dest}" ]; then
        fail_step "sing-box install" "Could not install the binary to ${dest}" \
            "- Check that the filesystem is writable and has free space." \
            "df -h $(dirname "${dest}")"
        return 1
    fi

    if ! "${dest}" version >/dev/null 2>&1; then
        fail_step "sing-box verify" \
            "${dest} was installed but does not run (wrong architecture or missing libc)." \
            "- Confirm the server architecture matches: $(uname -m)" \
            "${dest} version"
        return 1
    fi

    SING_BOX_DOWNLOADED_VERSION="${version}"
    ok "sing-box ${version} 已安装并校验通过：${dest}"
    return 0
}

# Validates a sing-box JSON config with the binary's own checker. This is the
# gate that prevents "installed successfully" on a config sing-box rejects.
sing_box_check_config() {
    local bin="$1"
    local config="$2"
    local label="$3"
    local output

    if ! output="$("${bin}" check -c "${config}" 2>&1)"; then
        echo >&2
        err "sing-box 拒绝了生成的配置："
        printf '%s\n' "${output}" >&2
        fail_step "${label} config validation" \
            "sing-box check failed for ${config}" \
            "- The generated config does not match this sing-box version's schema.
- Report the message above; do not start the service with this config." \
            "${bin} check -c ${config}"
        return 1
    fi
    ok "${label} 配置已通过 sing-box 校验。"
    return 0
}

anytls_random_port() {
    random_available_port
}

valid_port() {
    local port="${1:-}"
    [[ "${port}" =~ ^[0-9]+$ ]] && [ "${port}" -ge 1 ] && [ "${port}" -le 65535 ]
}

is_port_used() {
    local port="$1"

    if has_command ss; then
        ss -tuln | awk '{print $5}' | grep -Eq "[:.]${port}([[:space:]]|$)"
    elif has_command lsof; then
        lsof -i :"${port}" -sTCP:LISTEN >/dev/null 2>&1
    elif has_command netstat; then
        netstat -tuln 2>/dev/null | awk '{print $4}' | grep -Eq "[:.]${port}$"
    else
        return 1
    fi
}

random_available_port() {
    local port

    while true; do
        if has_command shuf; then
            port="$(shuf -i 2000-65000 -n 1)"
        else
            port="$(awk 'BEGIN{srand(); print int(2000 + rand() * 63000)}')"
        fi
        if ! is_port_used "${port}"; then
            echo "${port}"
            return 0
        fi
    done
}

anytls_prompt_port() {
    local input

    while true; do
        echo "回车使用随机可用端口，或自定义端口 [1-65535]。" >&2
        read -rp "AnyTLS 端口: " input
        if [ -z "${input:-}" ]; then
            input="$(anytls_random_port)"
        fi
        if ! valid_port "${input}"; then
            err "无效端口：${input}"
            continue
        fi
        if is_port_used "${input}"; then
            err "端口 ${input} 已被占用。"
            continue
        fi
        echo "${input}"
        return 0
    done
}

anytls_password() {
    if has_command uuidgen; then
        uuidgen
    elif [ -r /proc/sys/kernel/random/uuid ]; then
        cat /proc/sys/kernel/random/uuid
    else
        random_psk
    fi
}

urlencode() {
    local s="$1"
    local i
    local c

    for (( i=0; i<${#s}; i++ )); do
        c="${s:$i:1}"
        case "${c}" in
            [a-zA-Z0-9.~_-]) printf '%s' "${c}" ;;
            *) printf '%%%02X' "'${c}" ;;
        esac
    done
}

anytls_public_ip() {
    local ip

    ip="$(curl -fsSL --connect-timeout 5 -4 https://api.ipify.org 2>/dev/null || true)"
    if [ -n "${ip}" ]; then
        echo "${ip}"
        return 0
    fi

    curl -fsSL --connect-timeout 5 https://api.ipify.org 2>/dev/null || true
}

# ===========================================================================
# AnyTLS (sing-box)
#
# Two clearly separated TLS modes, both served by sing-box:
#   self   - self-signed certificate, no domain, no ACME, no port 80
#   acme   - a real certificate for a domain the operator controls
# Reality is never involved here: this module owns all certificate logic,
# and the VLESS module owns none of it.
# ===========================================================================

anytls_installed_version() {
    [ -f "${ANYTLS_SERVICE_FILE}" ] || return 0
    grep '^X-AT-Version=' "${ANYTLS_SERVICE_FILE}" | sed -E 's/^X-AT-Version=//' || true
}

anytls_is_installed() {
    [ -x "${ANYTLS_SING_BOX_BIN}" ] || [ -f "${ANYTLS_SERVICE_FILE}" ] || [ -s "${ANYTLS_JSON}" ] || [ -x "${ANYTLS_BIN}" ]
}

anytls_is_active() {
    service_is_active "${ANYTLS_SERVICE_NAME}"
}

# True when the box still carries the old anytls-go layout this script used
# before AnyTLS moved onto sing-box.
anytls_has_legacy_layout() {
    [ -x "${ANYTLS_BIN}" ] || [ -f "${ANYTLS_LEGACY_SING_BOX_CONFIG}" ] || \
        { [ -f "${ANYTLS_CONFIG}" ] && [ ! -s "${ANYTLS_JSON}" ]; }
}

# ---- read-back accessors: the on-disk JSON is the single source of truth ----

anytls_cfg_get() {
    local filter="$1"
    local value

    [ -s "${ANYTLS_JSON}" ] || return 1
    value="$(jq -r "${filter}" "${ANYTLS_JSON}" 2>/dev/null || true)"
    [ -n "${value}" ] && [ "${value}" != "null" ] || return 1
    printf '%s' "${value}"
}

anytls_cfg_port()     { anytls_cfg_get '.inbounds[0].listen_port'; }
anytls_cfg_password() { anytls_cfg_get '.inbounds[0].users[0].password'; }
anytls_cfg_cert()     { anytls_cfg_get '.inbounds[0].tls.certificate_path'; }
anytls_cfg_key()      { anytls_cfg_get '.inbounds[0].tls.key_path'; }
anytls_cfg_sni()      { anytls_cfg_get '.inbounds[0].tls.server_name'; }

# TLS mode is recorded next to the config; it decides whether clients must
# skip certificate verification.
anytls_mode() {
    [ -f "${ANYTLS_PARAMS_FILE}" ] || { echo "unknown"; return 0; }
    grep -E '^MODE=' "${ANYTLS_PARAMS_FILE}" | tail -n1 | cut -d= -f2- || echo "unknown"
}

anytls_domain() {
    [ -f "${ANYTLS_PARAMS_FILE}" ] || return 1
    grep -E '^DOMAIN=' "${ANYTLS_PARAMS_FILE}" | tail -n1 | cut -d= -f2-
}

anytls_write_params() {
    local mode="$1"
    local domain="${2:-}"

    mkdir -p "${ANYTLS_DIR}"
    cat > "${ANYTLS_PARAMS_FILE}" <<EOF
MODE=${mode}
DOMAIN=${domain}
EOF
    chmod 600 "${ANYTLS_PARAMS_FILE}"
    if [ -n "${domain}" ]; then
        printf '%s\n' "${domain}" > "${ANYTLS_DOMAIN_FILE}"
    fi
}

anytls_state() {
    if ! anytls_is_installed; then
        echo "not_installed"
        return 0
    fi
    if anytls_has_legacy_layout && [ ! -s "${ANYTLS_JSON}" ]; then
        echo "legacy_layout"
        return 0
    fi
    if [ ! -s "${ANYTLS_JSON}" ]; then
        echo "config_broken"
        return 0
    fi
    if ! jq -e '.inbounds[0].users[0].password' "${ANYTLS_JSON}" >/dev/null 2>&1; then
        echo "config_broken"
        return 0
    fi
    if [ ! -x "${ANYTLS_SING_BOX_BIN}" ]; then
        echo "binary_missing"
        return 0
    fi
    if [ ! -f "${ANYTLS_SERVICE_FILE}" ]; then
        echo "service_missing"
        return 0
    fi
    echo "ok"
}

# ---- self-signed certificate ----------------------------------------------

# Generates an EC key + long-lived self-signed certificate. Only regenerates
# when missing or when forced, so reinstalling does not invalidate clients
# that already pinned nothing but expect a stable cert.
anytls_ensure_self_signed_cert() {
    local force="${1:-false}"

    mkdir -p "${ANYTLS_CERT_DIR}"
    chmod 700 "${ANYTLS_DIR}" "${ANYTLS_CERT_DIR}" 2>/dev/null || true

    if [ "${force}" != "true" ] && [ -s "${ANYTLS_SELF_CERT}" ] && [ -s "${ANYTLS_SELF_KEY}" ]; then
        info "复用已有的自签证书。"
        return 0
    fi

    info "正在生成自签证书（CN=${ANYTLS_SELF_CN}）..."

    if ! openssl ecparam -genkey -name prime256v1 -out "${ANYTLS_SELF_KEY}" 2>/dev/null; then
        fail_step "self-signed key generation" "openssl could not create an EC private key." \
            "- Confirm openssl is installed and ${ANYTLS_CERT_DIR} is writable." \
            "openssl ecparam -genkey -name prime256v1 -out ${ANYTLS_SELF_KEY}"
        return 1
    fi

    if ! openssl req -new -x509 -days 3650 \
            -key "${ANYTLS_SELF_KEY}" \
            -out "${ANYTLS_SELF_CERT}" \
            -subj "/CN=${ANYTLS_SELF_CN}" 2>/dev/null; then
        fail_step "self-signed certificate generation" "openssl req failed." \
            "- Confirm openssl is installed and ${ANYTLS_CERT_DIR} is writable." \
            "openssl req -new -x509 -key ${ANYTLS_SELF_KEY} -out ${ANYTLS_SELF_CERT} -subj /CN=${ANYTLS_SELF_CN}"
        return 1
    fi

    chmod 600 "${ANYTLS_SELF_KEY}" "${ANYTLS_SELF_CERT}"

    if [ ! -s "${ANYTLS_SELF_CERT}" ] || [ ! -s "${ANYTLS_SELF_KEY}" ]; then
        fail_step "self-signed certificate generation" \
            "Certificate or key file is empty after generation."
        return 1
    fi

    ok "自签证书已就绪。"
    return 0
}

# ---- certificate validation ------------------------------------------------

# Confirms a cert/key pair is real, non-empty, parseable, matched, and (for
# ACME certs) actually covers the requested domain.
anytls_validate_cert_pair() {
    local cert="$1"
    local key="$2"
    local domain="${3:-}"
    local cert_mod key_mod

    if [ ! -s "${cert}" ]; then
        fail_step "certificate check" "Certificate file is missing or empty: ${cert}"
        return 1
    fi
    if [ ! -s "${key}" ]; then
        fail_step "certificate check" "Private key file is missing or empty: ${key}"
        return 1
    fi
    if ! openssl x509 -in "${cert}" -noout >/dev/null 2>&1; then
        fail_step "certificate check" "Not a valid PEM certificate: ${cert}" \
            "" "openssl x509 -in ${cert} -noout -text"
        return 1
    fi

    cert_mod="$(openssl x509 -in "${cert}" -noout -pubkey 2>/dev/null | openssl md5 2>/dev/null || true)"
    key_mod="$(openssl pkey -in "${key}" -pubout 2>/dev/null | openssl md5 2>/dev/null || true)"
    if [ -n "${cert_mod}" ] && [ -n "${key_mod}" ] && [ "${cert_mod}" != "${key_mod}" ]; then
        fail_step "certificate check" "The certificate and private key do not match." \
            "- Reissue the certificate, or point the config at the matching key."
        return 1
    fi

    if [ -n "${domain}" ]; then
        if ! openssl x509 -in "${cert}" -noout -text 2>/dev/null | grep -qi -- "${domain}"; then
            warn "证书中似乎不含 ${domain}，客户端可能拒绝。"
        fi
    fi

    if ! openssl x509 -in "${cert}" -noout -checkend 0 >/dev/null 2>&1; then
        warn "证书已过期。"
    fi

    return 0
}

# ---- ACME pre-flight -------------------------------------------------------

# Everything that can be checked cheaply before bothering the ACME server.
# HTTP-01 additionally needs DNS pointing here and a free port 80.
anytls_acme_preflight() {
    local domain="$1"
    local method="$2"
    local resolved4 resolved6 public4 public6 problems=0

    info "正在对 ${domain} 做证书申请前置检查..."

    if ! is_valid_domain "${domain}"; then
        fail_step "certificate pre-flight" "Not a valid domain name: ${domain}" \
            "- Enter a hostname such as proxy.example.com (not an IP, not a URL)."
        return 1
    fi

    # System clock: ACME rejects requests signed with a badly skewed clock.
    if has_command date; then
        local year
        year="$(date -u +%Y)"
        if [ "${year}" -lt 2024 ] || [ "${year}" -gt 2100 ]; then
            fail_step "certificate pre-flight" \
                "System clock looks wrong: $(date -u). ACME will reject this." \
                "- Fix the clock first, e.g. 'timedatectl set-ntp true'." \
                "timedatectl status"
            return 1
        fi
    fi

    # DNS resolution of the domain.
    resolved4="$(getent ahostsv4 "${domain}" 2>/dev/null | awk 'NR==1{print $1}' || true)"
    resolved6="$(getent ahostsv6 "${domain}" 2>/dev/null | awk 'NR==1{print $1}' || true)"
    if [ -z "${resolved4}" ] && [ -z "${resolved6}" ]; then
        fail_step "certificate pre-flight" "${domain} does not resolve from this server." \
            "- Add an A (IPv4) or AAAA (IPv6) record for ${domain}.
- Wait for DNS propagation, then retry." \
            "getent ahosts ${domain}"
        return 1
    fi
    ok "DNS 解析正常：${domain} -> ${resolved4:-${resolved6}}"

    public4="$(detect_public_ipv4)"
    public6="$(detect_public_ipv6)"

    if [ "${method}" = "http" ]; then
        # HTTP-01 validation connects back to this host, so the record must
        # point here and port 80 must be free.
        if [ -n "${resolved4}" ] && [ -n "${public4}" ] && [ "${resolved4}" != "${public4}" ]; then
            warn "${domain} resolves to ${resolved4} but this server's public IPv4 is ${public4}."
            problems=1
        fi
        if [ -z "${resolved4}" ] && [ -n "${resolved6}" ] && [ -n "${public6}" ] && [ "${resolved6}" != "${public6}" ]; then
            warn "${domain} resolves to ${resolved6} but this server's public IPv6 is ${public6}."
            problems=1
        fi
        if [ "${problems}" -ne 0 ]; then
            fail_step "certificate pre-flight" \
                "${domain} does not point at this server, so HTTP-01 validation cannot succeed." \
                "- Point the DNS record at this server, or use the Cloudflare DNS-01 method instead." \
                "getent ahosts ${domain}"
            return 1
        fi
        if is_port_used 80; then
            fail_step "certificate pre-flight" "Port 80 is already in use." \
                "- Stop the web server holding port 80 during issuance, or use DNS-01 instead." \
                "ss -tlnp | grep ':80 '"
            return 1
        fi
        ok "80 端口空闲，且 ${domain} 已指向本机。"
    fi

    # ACME endpoint reachability.
    if ! curl -fsS --connect-timeout 10 -o /dev/null https://acme-v02.api.letsencrypt.org/directory 2>/dev/null; then
        fail_step "certificate pre-flight" \
            "Cannot reach the Let's Encrypt ACME API from this server." \
            "- Check outbound HTTPS and DNS on the server.
- A firewall or upstream filter may be blocking acme-v02.api.letsencrypt.org." \
            "curl -v https://acme-v02.api.letsencrypt.org/directory"
        return 1
    fi
    ok "可以访问 ACME 接口。"

    return 0
}

# ---- certbot wrappers ------------------------------------------------------
#
# stderr is deliberately kept and echoed on failure: the whole point is that
# "Unable to register an account with ACME server" must reach the operator.

certbot_issue_standalone() {
    local domain="$1"
    local email="$2"
    local staging="${3:-false}"
    local staging_args=()
    local account_args=()
    local output
    local rc=0

    install_acme_packages || return 1

    [ "${staging}" = "true" ] && staging_args=(--test-cert)
    if [ -n "${email}" ]; then
        account_args=(--email "${email}")
    else
        account_args=(--register-unsafely-without-email)
    fi

    info "正在通过 HTTP-01 为 ${domain} 申请证书..."
    output="$(certbot certonly --standalone --non-interactive --agree-tos \
        --preferred-challenges http \
        "${account_args[@]}" \
        -d "${domain}" \
        "${staging_args[@]}" 2>&1)" || rc=$?

    printf '%s\n' "${output}"

    if [ "${rc}" -ne 0 ]; then
        fail_step "certificate issuance (HTTP-01)" \
            "certbot exited with status ${rc}. The real error is printed above." \
            "- 'Unable to register an account' usually means the server cannot reach
  the ACME API, the clock is wrong, or the email was rejected.
- Confirm ${domain} points at this server and port 80 is reachable from outside.
- Repeated failures can hit Let's Encrypt rate limits; try --test-cert (staging)." \
            "cat /var/log/letsencrypt/letsencrypt.log"
        return 1
    fi
    return 0
}

certbot_issue_cloudflare() {
    local domain="$1"
    local email="$2"
    local token="$3"
    local staging="${4:-false}"
    local propagation="${5:-60}"
    local staging_args=()
    local account_args=()
    local output
    local rc=0

    install_cloudflare_acme_packages || return 1

    mkdir -p "$(dirname "${CF_CERTBOT_CREDENTIALS}")"
    if [ -n "${token}" ]; then
        printf 'dns_cloudflare_api_token = %s\n' "${token}" > "${CF_CERTBOT_CREDENTIALS}"
        chmod 600 "${CF_CERTBOT_CREDENTIALS}"
    fi

    if [ ! -f "${CF_CERTBOT_CREDENTIALS}" ]; then
        fail_step "certificate issuance (DNS-01)" \
            "Cloudflare credentials file not found: ${CF_CERTBOT_CREDENTIALS}" \
            "- Provide an API token with Zone:DNS:Edit and Zone:Zone:Read."
        return 1
    fi
    chmod 600 "${CF_CERTBOT_CREDENTIALS}" 2>/dev/null || true

    [ "${staging}" = "true" ] && staging_args=(--test-cert)
    if [ -n "${email}" ]; then
        account_args=(--email "${email}")
    else
        account_args=(--register-unsafely-without-email)
    fi

    info "正在通过 Cloudflare DNS-01 为 ${domain} 申请证书..."
    output="$(certbot certonly --dns-cloudflare \
        --dns-cloudflare-credentials "${CF_CERTBOT_CREDENTIALS}" \
        --dns-cloudflare-propagation-seconds "${propagation}" \
        --non-interactive --agree-tos \
        "${account_args[@]}" \
        -d "${domain}" \
        "${staging_args[@]}" 2>&1)" || rc=$?

    printf '%s\n' "${output}"

    if [ "${rc}" -ne 0 ]; then
        fail_step "certificate issuance (DNS-01)" \
            "certbot exited with status ${rc}. The real error is printed above." \
            "- Check the API token scope (Zone:DNS:Edit + Zone:Zone:Read) and that it
  covers ${domain}.
- Increase the propagation wait if Cloudflare was slow to publish the record." \
            "cat /var/log/letsencrypt/letsencrypt.log"
        return 1
    fi
    return 0
}

copy_letsencrypt_cert_for_anytls() {
    local domain="$1"
    local src_dir="/etc/letsencrypt/live/${domain}"
    local cert_path="${ANYTLS_CERT_DIR}/${domain}.fullchain.pem"
    local key_path="${ANYTLS_CERT_DIR}/${domain}.privkey.pem"

    if [ ! -f "${src_dir}/fullchain.pem" ] || [ ! -f "${src_dir}/privkey.pem" ]; then
        fail_step "certificate install" \
            "Let's Encrypt files were not found under ${src_dir}" \
            "- certbot may have reported success without writing files.
- List what exists with: certbot certificates" \
            "ls -l ${src_dir}"
        return 1
    fi

    mkdir -p "${ANYTLS_CERT_DIR}"
    cp -L "${src_dir}/fullchain.pem" "${cert_path}"
    cp -L "${src_dir}/privkey.pem" "${key_path}"
    chmod 600 "${cert_path}" "${key_path}"

    printf '%s|%s' "${cert_path}" "${key_path}"
}

install_cert_renew_hook() {
    local hook_dir="/etc/letsencrypt/renewal-hooks/deploy"
    local hook_file="${hook_dir}/anytls-sing-box.sh"

    mkdir -p "${hook_dir}"
    cat > "${hook_file}" <<EOF
#!/usr/bin/env sh
set -eu
DOMAIN="\$(cat "${ANYTLS_DOMAIN_FILE}" 2>/dev/null || true)"
[ -n "\${DOMAIN}" ] || exit 0
[ -f "/etc/letsencrypt/live/\${DOMAIN}/fullchain.pem" ] || exit 0
mkdir -p "${ANYTLS_CERT_DIR}"
cp -L "/etc/letsencrypt/live/\${DOMAIN}/fullchain.pem" "${ANYTLS_CERT_DIR}/\${DOMAIN}.fullchain.pem"
cp -L "/etc/letsencrypt/live/\${DOMAIN}/privkey.pem" "${ANYTLS_CERT_DIR}/\${DOMAIN}.privkey.pem"
chmod 600 "${ANYTLS_CERT_DIR}/\${DOMAIN}.fullchain.pem" "${ANYTLS_CERT_DIR}/\${DOMAIN}.privkey.pem"
systemctl restart "${ANYTLS_SERVICE_NAME}" 2>/dev/null || true
EOF
    chmod +x "${hook_file}"
}

# ---- config + service ------------------------------------------------------

anytls_write_config() {
    local port="$1"
    local password="$2"
    local cert_path="$3"
    local key_path="$4"
    local sni="${5:-}"
    local sni_line=""

    mkdir -p "${ANYTLS_DIR}"
    chmod 700 "${ANYTLS_DIR}"

    if [ -n "${sni}" ]; then
        sni_line="$(printf '\n        "server_name": "%s",' "${sni}")"
    fi

    cat > "${ANYTLS_JSON}" <<EOF
{
  "log": {
    "level": "info",
    "timestamp": true
  },
  "inbounds": [
    {
      "type": "anytls",
      "tag": "anytls-in",
      "listen": "::",
      "listen_port": ${port},
      "users": [
        {
          "name": "main",
          "password": "${password}"
        }
      ],
      "padding_scheme": [],
      "tls": {
        "enabled": true,${sni_line}
        "certificate_path": "${cert_path}",
        "key_path": "${key_path}"
      }
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct"
    }
  ]
}
EOF
    chmod 600 "${ANYTLS_JSON}"
}

anytls_write_service() {
    local version="$1"

    version="${version:-$(anytls_installed_version)}"
    version="${version:-unknown}"

    cat > "${ANYTLS_SERVICE_FILE}" <<EOF
[Unit]
Description=AnyTLS Server Service via sing-box
Documentation=https://sing-box.sagernet.org/configuration/inbound/anytls/
After=network-online.target
Wants=network-online.target
X-AT-Version=${version}

[Service]
Type=simple
User=root
ExecStart=${ANYTLS_SING_BOX_BIN} run -c ${ANYTLS_JSON}
Restart=on-failure
RestartSec=10s
LimitNOFILE=65535
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
EOF
}

anytls_client_export() {
    local port password host mode domain sni insecure query alias_enc link link_enc

    if [ ! -s "${ANYTLS_JSON}" ]; then
        err "未找到 AnyTLS 配置：${ANYTLS_JSON}"
        return 1
    fi

    port="$(anytls_cfg_port)" || { err "无法从 ${ANYTLS_JSON} 读取 listen_port"; return 1; }
    password="$(anytls_cfg_password)" || { err "无法从 ${ANYTLS_JSON} 读取 password"; return 1; }
    sni="$(anytls_cfg_sni 2>/dev/null || true)"
    mode="$(anytls_mode)"
    domain="$(anytls_domain 2>/dev/null || true)"
    host="$(client_endpoint_host)"

    if [ "${mode}" = "acme" ] && [ -n "${domain}" ]; then
        # A real certificate: clients verify normally and connect by hostname.
        host="${domain}"
        insecure="false"
        query="?sni=${domain}&alpn=h2&insecure=0"
    else
        # Self-signed: verification must be disabled on the client.
        insecure="true"
        query="?sni=${sni:-${ANYTLS_SELF_CN}}&alpn=h2&insecure=1&allowInsecure=1"
    fi

    alias_enc="$(urlencode "${ANYTLS_ALIAS}")"
    link="anytls://${password}@${host}:${port}${query}#${alias_enc}"
    link_enc="$(urlencode "${link}")"

    mkdir -p "${ANYTLS_DIR}"
    cat > "${ANYTLS_CLIENT_FILE}" <<EOF
AnyTLS 客户端参数
（读取自 ${ANYTLS_JSON}）
TLS mode: ${mode}
Address: ${host}
Port: ${port}
Password: ${password}
SNI: ${sni:-${domain:-${ANYTLS_SELF_CN}}}
Domain: ${domain:-none}
Skip certificate verification: ${insecure}
URL: ${link}
QR: https://api.qrserver.com/v1/create-qr-code/?size=400x400&data=${link_enc}
EOF
    chmod 600 "${ANYTLS_CLIENT_FILE}"

    echo
    ok "AnyTLS 客户端参数"
    cat "${ANYTLS_CLIENT_FILE}"
    if [ "${mode}" != "acme" ]; then
        echo
        warn "自签证书模式：客户端必须开启「跳过证书验证」"
        warn "（insecure / allowInsecure / 允许不安全 = 开）。"
    fi
    return 0
}

anytls_verify_client_match() {
    local port password mismatch=0

    port="$(anytls_cfg_port)" || return 1
    password="$(anytls_cfg_password)" || return 1
    [ -s "${ANYTLS_CLIENT_FILE}" ] || return 1

    grep -q "${password}@" "${ANYTLS_CLIENT_FILE}" || mismatch=1
    grep -q ":${port}?" "${ANYTLS_CLIENT_FILE}" || mismatch=1

    if [ "${mismatch}" -ne 0 ]; then
        warn "分享链接与服务端配置不一致，请在 AnyTLS 菜单重新生成。"
        return 1
    fi
    ok "分享链接与服务端配置一致（密码、端口）。"
    return 0
}

# Writes config + unit, validates with sing-box, starts, verifies, exports.
anytls_apply() {
    local port="$1" password="$2" cert="$3" key="$4" sni="$5" mode="$6" domain="$7" version="$8"

    anytls_validate_cert_pair "${cert}" "${key}" "${domain}" || return 1

    anytls_write_config "${port}" "${password}" "${cert}" "${key}" "${sni}"
    anytls_write_params "${mode}" "${domain}"
    anytls_write_service "${version}"

    sing_box_check_config "${ANYTLS_SING_BOX_BIN}" "${ANYTLS_JSON}" "AnyTLS" || return 1
    activate_and_verify "${ANYTLS_SERVICE_NAME}" "${port}" "AnyTLS" || return 1

    ok "AnyTLS 已在端口 ${port} 上运行（证书模式：${mode}）。"
    anytls_client_export || return 1
    anytls_verify_client_match || true
    return 0
}

# Retires the old anytls-go unit/binary before sing-box takes over the port.
anytls_migrate_legacy() {
    anytls_has_legacy_layout || return 0

    warn "检测到旧版 anytls-go 结构，正在迁移到 sing-box。"
    systemctl disable --now "${ANYTLS_SERVICE_NAME}" 2>/dev/null || true
    backup_file "${ANYTLS_CONFIG}"
    backup_file "${ANYTLS_LEGACY_SING_BOX_CONFIG}"
    rm -f "${ANYTLS_BIN}"
    ok "旧版 AnyTLS 文件已备份，anytls-go 程序已移除。"
    return 0
}

# Recovers port/password from whichever old layout is present so a migration
# does not force clients to be reconfigured.
anytls_recover_port_password() {
    local port="" password=""

    if [ -s "${ANYTLS_JSON}" ]; then
        port="$(anytls_cfg_port 2>/dev/null || true)"
        password="$(anytls_cfg_password 2>/dev/null || true)"
    fi
    if [ -z "${port}" ] && [ -f "${ANYTLS_LEGACY_SING_BOX_CONFIG}" ]; then
        port="$(jq -r '.inbounds[0].listen_port // empty' "${ANYTLS_LEGACY_SING_BOX_CONFIG}" 2>/dev/null || true)"
        password="$(jq -r '.inbounds[0].users[0].password // empty' "${ANYTLS_LEGACY_SING_BOX_CONFIG}" 2>/dev/null || true)"
    fi
    if [ -z "${port}" ] && [ -f "${ANYTLS_CONFIG}" ]; then
        port="$(sed -nE 's/^[[:space:]]*listen:[[:space:]]*.*:([0-9]+)[[:space:]]*$/\1/p' "${ANYTLS_CONFIG}" | head -n1 || true)"
        password="$(sed -nE 's/^[[:space:]]*password:[[:space:]]*(.*)$/\1/p' "${ANYTLS_CONFIG}" | head -n1 || true)"
    fi

    printf '%s|%s' "${port}" "${password}"
}

# ---- install entry points --------------------------------------------------

anytls_install_self_signed() {
    local state choice recovered port password version

    preflight_common "AnyTLS" || return 1

    state="$(anytls_state)"
    if [ "${state}" != "not_installed" ]; then
        echo
        warn "AnyTLS 已安装（状态：${state}）。"
        echo "1. 保留现有端口和密码，用自签证书重建"
        echo "2. 备份当前配置，然后全新生成"
        echo "3. 查看当前客户端配置"
        echo "0. 取消"
        read -rp "请选择 [0-3]: " choice
        case "${choice}" in
            1)
                recovered="$(anytls_recover_port_password)"
                port="${recovered%%|*}"
                password="${recovered#*|}"
                ;;
            2)
                backup_file "${ANYTLS_JSON}"
                backup_file "${ANYTLS_PARAMS_FILE}"
                ;;
            3) anytls_client_export; return $? ;;
            *) info "已取消。"; return 0 ;;
        esac
    fi

    anytls_migrate_legacy

    install_sing_box_binary "${ANYTLS_SING_BOX_BIN}" || return 1
    version="${SING_BOX_DOWNLOADED_VERSION}"

    if [ -z "${port:-}" ]; then
        port="$(anytls_prompt_port)"
    else
        info "沿用现有端口 ${port}。"
    fi
    if [ -z "${password:-}" ]; then
        password="$(anytls_password)"
    else
        info "沿用现有密码。"
    fi

    anytls_ensure_self_signed_cert false || return 1

    anytls_apply "${port}" "${password}" \
        "${ANYTLS_SELF_CERT}" "${ANYTLS_SELF_KEY}" \
        "${ANYTLS_SELF_CN}" "self" "" "${version}"
}

# Shared tail for all three real-certificate paths.
anytls_finish_with_cert() {
    local domain="$1"
    local cert_pair cert_path key_path version port password recovered

    if ! cert_pair="$(copy_letsencrypt_cert_for_anytls "${domain}")"; then
        return 1
    fi
    cert_path="${cert_pair%%|*}"
    key_path="${cert_pair#*|}"

    anytls_validate_cert_pair "${cert_path}" "${key_path}" "${domain}" || return 1
    install_cert_renew_hook

    anytls_migrate_legacy
    install_sing_box_binary "${ANYTLS_SING_BOX_BIN}" || return 1
    version="${SING_BOX_DOWNLOADED_VERSION}"

    recovered="$(anytls_recover_port_password)"
    port="${recovered%%|*}"
    password="${recovered#*|}"
    if [ -z "${port}" ]; then
        port="$(anytls_prompt_port)"
    else
        info "沿用现有端口 ${port}。"
    fi
    [ -n "${password}" ] || password="$(anytls_password)"

    anytls_apply "${port}" "${password}" "${cert_path}" "${key_path}" \
        "${domain}" "acme" "${domain}" "${version}"
}

# Offers a graceful downgrade instead of leaving the box with nothing.
anytls_offer_self_signed_fallback() {
    local choice

    echo
    warn "真实证书流程未完成。"
    read -rp "是否回退到自签证书模式以保证 AnyTLS 可用？[y/N]: " choice
    if [[ "${choice}" =~ ^[Yy]$ ]]; then
        anytls_install_self_signed
        return $?
    fi
    info "未执行回退，AnyTLS 保持原样。"
    return 1
}

anytls_install_with_acme_cert() {
    local domain email staging_choice staging="false"

    preflight_common "AnyTLS" || return 1

    echo
    info "使用 HTTP-01 申请真实证书（certbot standalone）。"
    warn "域名必须已解析到本机，且 80 端口可从外部访问。"
    read -rp "AnyTLS 证书使用的域名: " domain
    if ! is_valid_domain "${domain}"; then
        fail_step "AnyTLS certificate setup" "Not a valid domain: ${domain}"
        return 1
    fi
    read -rp "Let's Encrypt 通知邮箱 [回车 = 不填]: " email
    read -rp "是否使用 Let's Encrypt 测试证书？[y/N]: " staging_choice
    [[ "${staging_choice}" =~ ^[Yy]$ ]] && staging="true"

    if ! anytls_acme_preflight "${domain}" "http"; then
        anytls_offer_self_signed_fallback
        return $?
    fi

    if ! certbot_issue_standalone "${domain}" "${email}" "${staging}"; then
        anytls_offer_self_signed_fallback
        return $?
    fi

    anytls_finish_with_cert "${domain}"
}

anytls_install_with_cloudflare_cert() {
    local domain email token propagation staging_choice staging="false"

    preflight_common "AnyTLS" || return 1

    echo
    info "使用 Cloudflare DNS-01 申请真实证书。"
    warn "不需要 80 端口。请创建具备 Zone:DNS:Edit 和 Zone:Zone:Read 权限的 API 令牌。"
    read -rp "AnyTLS 证书使用的域名: " domain
    if ! is_valid_domain "${domain}"; then
        fail_step "AnyTLS certificate setup" "Not a valid domain: ${domain}"
        return 1
    fi
    read -rp "Let's Encrypt 通知邮箱 [回车 = 不填]: " email
    if [ -f "${CF_CERTBOT_CREDENTIALS}" ]; then
        read -rsp "Cloudflare API 令牌 [回车 = 使用已保存的]: " token
        echo
    else
        read -rsp "Cloudflare API 令牌: " token
        echo
        if [ -z "${token}" ]; then
            fail_step "AnyTLS certificate setup" "A Cloudflare API token is required."
            return 1
        fi
    fi
    read -rp "DNS 生效等待秒数 [回车 = 60]: " propagation
    propagation="${propagation:-60}"
    if ! [[ "${propagation}" =~ ^[0-9]+$ ]]; then
        fail_step "AnyTLS certificate setup" "Invalid propagation seconds: ${propagation}"
        return 1
    fi
    read -rp "是否使用 Let's Encrypt 测试证书？[y/N]: " staging_choice
    [[ "${staging_choice}" =~ ^[Yy]$ ]] && staging="true"

    # DNS-01 does not need the record to point here, so skip that check.
    if ! anytls_acme_preflight "${domain}" "dns"; then
        anytls_offer_self_signed_fallback
        return $?
    fi

    if ! certbot_issue_cloudflare "${domain}" "${email}" "${token}" "${staging}" "${propagation}"; then
        anytls_offer_self_signed_fallback
        return $?
    fi

    anytls_finish_with_cert "${domain}"
}

anytls_apply_existing_cert() {
    local domain

    preflight_common "AnyTLS" || return 1

    read -rp "要使用的已有 Let's Encrypt 证书域名: " domain
    if ! is_valid_domain "${domain}"; then
        fail_step "AnyTLS certificate setup" "Not a valid domain: ${domain}"
        return 1
    fi

    if [ ! -d "/etc/letsencrypt/live/${domain}" ]; then
        fail_step "AnyTLS certificate setup" \
            "No existing certificate found at /etc/letsencrypt/live/${domain}" \
            "- List what is available with: certbot certificates
- Or issue a new certificate from the AnyTLS menu." \
            "certbot certificates"
        return 1
    fi

    anytls_finish_with_cert "${domain}"
}

anytls_update() {
    local port password cert key sni mode domain version

    preflight_common "AnyTLS" || return 1

    if ! anytls_is_installed; then
        fail_step "AnyTLS update" "AnyTLS is not installed." "- Install it first."
        return 1
    fi

    if [ ! -s "${ANYTLS_JSON}" ]; then
        warn "未找到 sing-box 版 AnyTLS 配置，改为执行自签安装。"
        anytls_install_self_signed
        return $?
    fi

    port="$(anytls_cfg_port)" || { fail_step "AnyTLS update" "listen_port missing from config."; return 1; }
    password="$(anytls_cfg_password)" || { fail_step "AnyTLS update" "password missing from config."; return 1; }
    cert="$(anytls_cfg_cert)" || { fail_step "AnyTLS update" "certificate_path missing from config."; return 1; }
    key="$(anytls_cfg_key)" || { fail_step "AnyTLS update" "key_path missing from config."; return 1; }
    sni="$(anytls_cfg_sni 2>/dev/null || true)"
    mode="$(anytls_mode)"
    domain="$(anytls_domain 2>/dev/null || true)"

    info "正在升级 sing-box，端口、密码、证书保持不变。"
    install_sing_box_binary "${ANYTLS_SING_BOX_BIN}" || return 1
    version="${SING_BOX_DOWNLOADED_VERSION}"

    anytls_apply "${port}" "${password}" "${cert}" "${key}" "${sni}" "${mode}" "${domain}" "${version}"
}

anytls_change_value() {
    local field="$1"
    local port password cert key sni mode domain

    preflight_common "AnyTLS" || return 1

    if [ ! -s "${ANYTLS_JSON}" ] || [ ! -x "${ANYTLS_SING_BOX_BIN}" ]; then
        fail_step "AnyTLS change ${field}" "AnyTLS is not fully installed." \
            "- Run an AnyTLS install option first."
        return 1
    fi

    port="$(anytls_cfg_port)" || return 1
    password="$(anytls_cfg_password)" || return 1
    cert="$(anytls_cfg_cert)" || return 1
    key="$(anytls_cfg_key)" || return 1
    sni="$(anytls_cfg_sni 2>/dev/null || true)"
    mode="$(anytls_mode)"
    domain="$(anytls_domain 2>/dev/null || true)"

    case "${field}" in
        port)     port="$(anytls_prompt_port)" ;;
        password) password="$(anytls_password)"; info "新的密码：${password}" ;;
        *) fail_step "AnyTLS change" "Unknown field: ${field}"; return 1 ;;
    esac

    backup_file "${ANYTLS_JSON}"
    anytls_apply "${port}" "${password}" "${cert}" "${key}" "${sni}" "${mode}" "${domain}" ""
}

renew_anytls_certificate() {
    local rc=0
    local output

    preflight_common "AnyTLS" || return 1
    install_acme_packages || return 1

    output="$(certbot renew 2>&1)" || rc=$?
    printf '%s\n' "${output}"

    if [ "${rc}" -ne 0 ]; then
        fail_step "certificate renewal" "certbot renew exited with status ${rc}." \
            "- The error above explains which domain failed." \
            "cat /var/log/letsencrypt/letsencrypt.log"
        return 1
    fi

    if anytls_is_installed && [ -s "${ANYTLS_JSON}" ]; then
        systemctl restart "${ANYTLS_SERVICE_NAME}" 2>/dev/null || true
        anytls_client_export || true
    fi
    return 0
}

anytls_uninstall() {
    local confirm

    require_root
    if ! anytls_is_installed; then
        warn "AnyTLS 尚未安装。"
        return 0
    fi

    warn "只会删除本模块自己创建的文件："
    echo "  ${ANYTLS_DIR}"
    echo "  ${ANYTLS_SERVICE_FILE}"
    warn "/etc/letsencrypt 下的证书不会被删除。"
    read -rp "确认卸载 AnyTLS？[y/N]: " confirm
    [[ "${confirm}" =~ ^[Yy]$ ]] || return 0

    systemctl disable --now "${ANYTLS_SERVICE_NAME}" 2>/dev/null || true
    rm -f "${ANYTLS_SERVICE_FILE}"
    rm -rf "${ANYTLS_DIR}"
    systemctl daemon-reload 2>/dev/null || true
    ok "AnyTLS 已卸载，Snell 和 VLESS+Reality 未受影响。"
}

anytls_status() {
    local port

    if ! anytls_is_installed; then
        warn "AnyTLS 尚未安装。"
        return 0
    fi

    echo
    ok "AnyTLS"
    echo "状态：$(anytls_state)"
    echo "sing-box 版本：$(anytls_installed_version)"
    echo "证书模式：$(anytls_mode)"
    echo "域名：$(anytls_domain 2>/dev/null || echo 无)"
    echo "端口：$(anytls_cfg_port 2>/dev/null || echo 未知)"

    if anytls_is_active; then
        echo "服务：运行中"
    else
        echo "服务：已停止"
    fi

    port="$(anytls_cfg_port 2>/dev/null || true)"
    if [ -n "${port}" ]; then
        port_is_listening "${port}" 1
        case "$?" in
            0) echo "端口监听：${port} 正在监听" ;;
            2) warn "端口监听：无法验证（安装 iproute2 可启用 ss 检测）" ;;
            *) warn "端口监听：端口 ${port} 上没有任何监听" ;;
        esac
    fi

    systemctl --no-pager --full status "${ANYTLS_SERVICE_NAME}" 2>/dev/null | sed -n '1,8p' || true
}

anytls_start() {
    require_root
    anytls_is_installed || { warn "AnyTLS 尚未安装。"; return 0; }
    systemctl start "${ANYTLS_SERVICE_NAME}"
    anytls_status
}

anytls_stop() {
    require_root
    anytls_is_installed || { warn "AnyTLS 尚未安装。"; return 0; }
    systemctl stop "${ANYTLS_SERVICE_NAME}"
    anytls_status
}

anytls_logs() {
    journalctl -u "${ANYTLS_SERVICE_NAME}" --no-pager -n 80 || true
}

anytls_menu() {
    local choice

    while true; do
        clear
        echo -e "${CYAN}============================================${RESET}"
        echo -e "${CYAN}        AnyTLS 管理${RESET}"
        echo -e "${CYAN}============================================${RESET}"
        echo "-- 模式一：自签证书（不需要域名）--"
        echo "1. 安装 / 重装（使用自签证书）"
        echo "-- 模式二：你自己域名的真实证书 --"
        echo "2. HTTP-01 申请证书（需要 80 端口 + 域名解析到本机）"
        echo "3. Cloudflare DNS-01 申请证书（不需要 80 端口）"
        echo "4. 使用本机已申请过的证书"
        echo "5. 立即续期证书"
        echo "-- 日常管理 --"
        echo "6. 升级 sing-box（保留端口、密码、证书）"
        echo "7. 查看客户端配置（分享链接）"
        echo "8. 修改端口"
        echo "9. 修改密码"
        echo "10. 查看服务状态"
        echo "11. 启动服务"
        echo "12. 停止服务"
        echo "13. 查看日志"
        echo "14. 卸载 AnyTLS"
        echo "0. 返回上级"
        echo -e "${CYAN}============================================${RESET}"
        read -rp "请选择 [0-14]: " choice
        case "${choice}" in
            1) anytls_install_self_signed || true ;;
            2) anytls_install_with_acme_cert || true ;;
            3) anytls_install_with_cloudflare_cert || true ;;
            4) anytls_apply_existing_cert || true ;;
            5) renew_anytls_certificate || true ;;
            6) anytls_update || true ;;
            7) anytls_client_export || true ;;
            8) anytls_change_value port || true ;;
            9) anytls_change_value password || true ;;
            10) anytls_status ;;
            11) anytls_start ;;
            12) anytls_stop ;;
            13) anytls_logs ;;
            14) anytls_uninstall ;;
            0) return 0 ;;
            *) err "无效选项。" ;;
        esac
        echo
        read -rp "按回车返回 AnyTLS 菜单..." _
    done
}

# ===========================================================================
# VLESS + Reality (sing-box)
#
# Reality has no relationship with the operator's own domain or certificate.
# It borrows the TLS handshake of an unrelated third-party site, so this
# module never touches ACME/certbot and never asks for a domain that must
# resolve to this server.
# ===========================================================================

vless_prompt_port() {
    local input

    while true; do
        echo "回车使用随机可用端口，或自定义端口 [1-65535]。" >&2
        read -rp "VLESS+Reality 监听端口: " input
        if [ -z "${input:-}" ]; then
            input="$(random_available_port)"
            echo "已随机选择端口：${input}" >&2
        fi
        if ! valid_port "${input}"; then
            err "无效端口：${input}"
            continue
        fi
        if is_port_used "${input}"; then
            err "端口 ${input} 已被占用。"
            continue
        fi
        printf '%s' "${input}"
        return 0
    done
}

# Reality needs the handshake target to speak TLS 1.3 AND to negotiate the
# X25519 group. A target that only offers other groups makes every Reality
# handshake fail while every other check still looks healthy.
# Returns 0 suitable, 1 unsuitable, 2 could not test.
reality_target_is_suitable() {
    local host="$1"
    local out

    has_command openssl || return 2
    has_command timeout || return 2

    out="$(timeout 12 openssl s_client -connect "${host}:443" -servername "${host}" \
        -tls1_3 -groups X25519 </dev/null 2>&1 || true)"

    printf '%s' "${out}" | grep -q "CONNECTED" || return 1
    printf '%s' "${out}" | grep -qE "TLSv1\.3" || return 1
    # OpenSSL reports the negotiated group; if it names one, it must be X25519.
    if printf '%s' "${out}" | grep -qE "Negotiated TLS1\.3 group"; then
        printf '%s' "${out}" | grep -qE "Negotiated TLS1\.3 group: *X25519" || return 1
    fi
    return 0
}

# Probes the built-in candidates and returns the first one this server can
# actually use, so the default is never a target that cannot work here.
reality_pick_working_target() {
    local candidate

    while IFS= read -r candidate; do
        [ -n "${candidate}" ] || continue
        if reality_target_is_suitable "${candidate}"; then
            printf '%s' "${candidate}"
            return 0
        fi
    done <<EOF
${VLESS_SNI_CANDIDATES}
EOF
    return 1
}

# Reality handshake target ("masquerade site"). Deliberately NOT called a
# domain prompt: it must be a third-party site, never the user's own domain.
vless_prompt_sni() {
    local choice
    local domain
    local current="${1:-}"
    local i
    local candidate
    local list=()

    while IFS= read -r candidate; do
        [ -n "${candidate}" ] && list+=("${candidate}")
    done <<EOF
${VLESS_SNI_CANDIDATES}
EOF

    while true; do
        {
            echo
            info "Reality 伪装站点（TLS 握手目标）"
            echo "这是 Reality 用来伪装的第三方知名 HTTPS 网站。"
            echo "它不是你的域名，不需要解析到本机，也不需要证书。"
            echo "请选一个你服务器能正常访问、且未被屏蔽的站点。"
            echo
            for i in "${!list[@]}"; do
                if [ "${list[$i]}" = "${VLESS_DEFAULT_SNI}" ]; then
                    echo "$((i + 1)). ${list[$i]}（默认）"
                else
                    echo "$((i + 1)). ${list[$i]}"
                fi
            done
            echo "$(( ${#list[@]} + 1 )). 手动输入其它第三方站点"
            echo "$(( ${#list[@]} + 2 )). 自动挑选一个本机实测可用的站点（推荐，回车同此项）"
            [ -n "${current}" ] && echo "当前值：${current}"
        } >&2

        read -rp "请选择 [1-$(( ${#list[@]} + 2 ))，回车 = 自动挑选]: " choice

        # Auto-select probes the candidates and keeps the first one that this
        # server can genuinely complete a TLS 1.3 + X25519 handshake with.
        if [ -z "${choice}" ] || [ "${choice}" = "$(( ${#list[@]} + 2 ))" ]; then
            info "正在测试候选站点是否支持 TLS 1.3 + X25519..." >&2
            if domain="$(reality_pick_working_target)"; then
                ok "已选择 ${domain}（实测可用）。" >&2
                printf '%s' "${domain}"
                return 0
            fi
            warn "没有候选站点通过检测。" >&2
            warn "暂用 ${VLESS_DEFAULT_SNI}，安装后请再验证。" >&2
            printf '%s' "${VLESS_DEFAULT_SNI}"
            return 0
        fi

        if [[ "${choice}" =~ ^[0-9]+$ ]] && [ "${choice}" -ge 1 ] && [ "${choice}" -le "${#list[@]}" ]; then
            domain="${list[$((choice - 1))]}"
        elif [ "${choice}" = "$(( ${#list[@]} + 1 ))" ]; then
            read -rp "第三方站点域名（例如 www.example.com）: " domain
            if ! is_valid_domain "${domain}"; then
                err "不是合法的域名：${domain}"
                continue
            fi
        else
            err "请从列表中选择。"
            continue
        fi

        # Verify before accepting: an unsuitable target makes every Reality
        # handshake fail while all the other checks still look fine.
        info "正在检测 ${domain} 是否支持 TLS 1.3 + X25519..." >&2
        reality_target_is_suitable "${domain}"
        case "$?" in
            0)
                ok "${domain} 可用。" >&2
                printf '%s' "${domain}"
                return 0
                ;;
            2)
                warn "无法检测 ${domain}（缺少 openssl/timeout），已接受。" >&2
                printf '%s' "${domain}"
                return 0
                ;;
            *)
                err "${domain} 不支持 TLS 1.3 + X25519。" >&2
                err "Reality 无法使用该站点，请换一个。" >&2
                continue
                ;;
        esac
    done
}

vless_gen_uuid() {
    local value=""

    if [ -x "${VLESS_SING_BOX_BIN}" ]; then
        value="$("${VLESS_SING_BOX_BIN}" generate uuid 2>/dev/null | tr -d '[:space:]' || true)"
    fi
    if [ -z "${value}" ] && [ -r /proc/sys/kernel/random/uuid ]; then
        value="$(tr -d '[:space:]' < /proc/sys/kernel/random/uuid)"
    fi
    if [ -z "${value}" ] && has_command uuidgen; then
        value="$(uuidgen | tr -d '[:space:]')"
    fi

    if ! [[ "${value}" =~ ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$ ]]; then
        fail_step "UUID generation" "Could not produce a valid UUID." \
            "- Ensure /proc/sys/kernel/random/uuid is readable or install uuid-runtime."
        return 1
    fi
    printf '%s' "${value}"
}

# Reality short ID: hex, even length, 1..16 chars. openssl is the primary
# source so this never depends on sing-box CLI argument ordering.
vless_gen_short_id() {
    local value=""

    if has_command openssl; then
        value="$(openssl rand -hex 4 2>/dev/null | tr -d '[:space:]' || true)"
    fi
    if [ -z "${value}" ] && [ -x "${VLESS_SING_BOX_BIN}" ]; then
        value="$("${VLESS_SING_BOX_BIN}" generate rand --hex 4 2>/dev/null | tr -d '[:space:]' || true)"
    fi
    if [ -z "${value}" ] && [ -r /dev/urandom ]; then
        value="$(tr -dc 'a-f0-9' </dev/urandom | head -c 8)"
    fi

    if ! [[ "${value}" =~ ^([0-9a-f]{2}){1,8}$ ]]; then
        fail_step "Reality short ID generation" "Could not produce a valid hex short ID." \
            "- Ensure openssl is installed."
        return 1
    fi
    printf '%s' "${value}"
}

b64url_decode() {
    local s="${1:-}"
    local pad
    local i

    [ -n "${s}" ] || return 1
    pad=$(( (4 - ${#s} % 4) % 4 ))

    for (( i=0; i<pad; i++ )); do
        s="${s}="
    done
    printf '%s' "${s}" | tr '_-' '/+' | base64 -d 2>/dev/null
}

b64url_encode() {
    base64 2>/dev/null | tr '+/' '-_' | tr -d '=\n'
}

# Derives the X25519 public key from a raw Reality private key by rebuilding a
# PKCS#8 wrapper around the 32 key bytes. Lets the diagnostics prove that the
# public key handed to clients really belongs to the server's private key.
vless_derive_reality_public_key() {
    local priv="$1"
    local tmpd
    local size
    local derived

    has_command openssl || return 1
    tmpd="$(mktemp -d)"

    b64url_decode "${priv}" > "${tmpd}/raw.priv" 2>/dev/null
    size="$(wc -c < "${tmpd}/raw.priv" 2>/dev/null || echo 0)"
    if [ "${size}" -ne 32 ]; then
        rm -rf "${tmpd}"
        return 1
    fi

    # PKCS#8 PrivateKeyInfo header for an X25519 key with a 32-byte payload.
    printf '\x30\x2e\x02\x01\x00\x30\x05\x06\x03\x2b\x65\x6e\x04\x22\x04\x20' > "${tmpd}/pkcs8.der"
    cat "${tmpd}/raw.priv" >> "${tmpd}/pkcs8.der"

    derived="$(openssl pkey -inform DER -in "${tmpd}/pkcs8.der" -pubout -outform DER 2>/dev/null \
        | tail -c 32 | b64url_encode)"
    rm -rf "${tmpd}"

    [ -n "${derived}" ] || return 1
    printf '%s' "${derived}"
}

# Returns "private|public". Handles both "PrivateKey: x" and "PrivateKey x".
vless_gen_reality_keypair() {
    local output
    local priv
    local pub

    if [ ! -x "${VLESS_SING_BOX_BIN}" ]; then
        fail_step "Reality key generation" "sing-box binary not present at ${VLESS_SING_BOX_BIN}."
        return 1
    fi

    if ! output="$("${VLESS_SING_BOX_BIN}" generate reality-keypair 2>&1)"; then
        printf '%s\n' "${output}" >&2
        fail_step "Reality key generation" "sing-box generate reality-keypair failed." \
            "- The sing-box binary may be incomplete; reinstall it." \
            "${VLESS_SING_BOX_BIN} generate reality-keypair"
        return 1
    fi

    priv="$(printf '%s\n' "${output}" | awk '/PrivateKey/ {print $NF}' | tr -d '"[:space:]' | head -n1)"
    pub="$(printf '%s\n' "${output}" | awk '/PublicKey/ {print $NF}' | tr -d '"[:space:]' | head -n1)"

    if [ -z "${priv}" ] || [ -z "${pub}" ]; then
        printf '%s\n' "${output}" >&2
        fail_step "Reality key generation" "Could not parse the key pair output shown above." \
            "- The sing-box CLI output format may have changed." \
            "${VLESS_SING_BOX_BIN} generate reality-keypair"
        return 1
    fi

    printf '%s|%s' "${priv}" "${pub}"
}

write_vless_config() {
    local port="$1"
    local uuid="$2"
    local sni="$3"
    local priv="$4"
    local sid="$5"

    mkdir -p "${VLESS_DIR}"
    chmod 700 "${VLESS_DIR}"

    cat > "${VLESS_CONFIG}" <<EOF
{
  "log": {
    "level": "info",
    "timestamp": true
  },
  "inbounds": [
    {
      "type": "vless",
      "tag": "vless-in",
      "listen": "::",
      "listen_port": ${port},
      "users": [
        {
          "name": "main",
          "uuid": "${uuid}",
          "flow": "xtls-rprx-vision"
        }
      ],
      "tls": {
        "enabled": true,
        "server_name": "${sni}",
        "reality": {
          "enabled": true,
          "handshake": {
            "server": "${sni}",
            "server_port": 443
          },
          "private_key": "${priv}",
          "short_id": ["${sid}"]
        }
      }
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct"
    }
  ],
  "route": {
    "rules": [
      {
        "action": "sniff"
      }
    ],
    "final": "direct"
  }
}
EOF
    chmod 600 "${VLESS_CONFIG}"
}

vless_save_public_key() {
    mkdir -p "${VLESS_DIR}"
    printf '%s\n' "$1" > "${VLESS_PUBKEY_FILE}"
    chmod 600 "${VLESS_PUBKEY_FILE}"
}

# Earlier versions of this script kept every Reality value in params.conf.
# The public key is the only one that cannot be recomputed, so recover it
# into its own file instead of declaring those installs broken.
vless_migrate_legacy_params() {
    local pub

    [ -s "${VLESS_PUBKEY_FILE}" ] && return 0
    [ -f "${VLESS_PARAMS_FILE}" ] || return 0

    pub="$(grep -E '^PUBLIC_KEY=' "${VLESS_PARAMS_FILE}" | tail -n1 | cut -d= -f2- | tr -d '[:space:]' || true)"
    [ -n "${pub}" ] || return 0

    vless_save_public_key "${pub}"
    ok "已从 ${VLESS_PARAMS_FILE} 恢复 Reality 公钥到 ${VLESS_PUBKEY_FILE}"
    return 0
}

# ---- read-back accessors: the on-disk JSON is the single source of truth ----

vless_cfg_get() {
    local filter="$1"
    local value

    [ -s "${VLESS_CONFIG}" ] || return 1
    value="$(jq -r "${filter}" "${VLESS_CONFIG}" 2>/dev/null || true)"
    [ -n "${value}" ] && [ "${value}" != "null" ] || return 1
    printf '%s' "${value}"
}

vless_cfg_port()  { vless_cfg_get '.inbounds[0].listen_port'; }
vless_cfg_uuid()  { vless_cfg_get '.inbounds[0].users[0].uuid'; }
vless_cfg_sni()   { vless_cfg_get '.inbounds[0].tls.server_name'; }
vless_cfg_sid()   { vless_cfg_get '.inbounds[0].tls.reality.short_id[0]'; }
vless_cfg_priv()  { vless_cfg_get '.inbounds[0].tls.reality.private_key'; }
vless_cfg_pubkey() {
    [ -s "${VLESS_PUBKEY_FILE}" ] || vless_migrate_legacy_params >/dev/null 2>&1 || true
    [ -s "${VLESS_PUBKEY_FILE}" ] || return 1
    tr -d '[:space:]' < "${VLESS_PUBKEY_FILE}"
}

vless_installed_version() {
    [ -f "${VLESS_SERVICE_FILE}" ] || return 0
    grep '^X-VLESS-Version=' "${VLESS_SERVICE_FILE}" | sed -E 's/^X-VLESS-Version=//' || true
}

write_vless_service() {
    local version="$1"

    if [ -z "${version}" ]; then
        version="$(vless_installed_version)"
        version="${version:-unknown}"
    fi

    cat > "${VLESS_SERVICE_FILE}" <<EOF
[Unit]
Description=VLESS Reality Server Service via sing-box
Documentation=https://sing-box.sagernet.org/configuration/inbound/vless/
After=network-online.target
Wants=network-online.target
X-VLESS-Version=${version}

[Service]
Type=simple
User=root
ExecStart=${VLESS_SING_BOX_BIN} run -c ${VLESS_CONFIG}
Restart=on-failure
RestartSec=10s
LimitNOFILE=65535
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
EOF
}

vless_is_installed() {
    [ -x "${VLESS_SING_BOX_BIN}" ] || [ -f "${VLESS_SERVICE_FILE}" ] || [ -s "${VLESS_CONFIG}" ]
}

vless_is_active() {
    service_is_active "${VLESS_SERVICE_NAME}"
}

# Classifies the install so each menu action can react instead of blindly
# overwriting: not_installed | ok | binary_missing | service_missing |
# config_broken
vless_state() {
    if ! vless_is_installed; then
        echo "not_installed"
        return 0
    fi
    vless_migrate_legacy_params >/dev/null 2>&1 || true
    if [ ! -s "${VLESS_CONFIG}" ]; then
        echo "config_broken"
        return 0
    fi
    if ! jq -e '.inbounds[0].tls.reality.private_key' "${VLESS_CONFIG}" >/dev/null 2>&1; then
        echo "config_broken"
        return 0
    fi
    if [ ! -s "${VLESS_PUBKEY_FILE}" ]; then
        echo "config_broken"
        return 0
    fi
    if [ ! -x "${VLESS_SING_BOX_BIN}" ]; then
        echo "binary_missing"
        return 0
    fi
    if [ ! -f "${VLESS_SERVICE_FILE}" ]; then
        echo "service_missing"
        return 0
    fi
    echo "ok"
}

vless_backup_existing() {
    backup_file "${VLESS_CONFIG}"
    backup_file "${VLESS_PUBKEY_FILE}"
}

# Builds the share link strictly from the values sing-box will actually serve.
vless_client_export() {
    local port uuid sni pub sid host alias_enc link link_enc

    if [ ! -s "${VLESS_CONFIG}" ]; then
        err "未找到 VLESS+Reality 配置：${VLESS_CONFIG}"
        return 1
    fi

    port="$(vless_cfg_port)" || { err "无法从 ${VLESS_CONFIG} 读取 listen_port"; return 1; }
    uuid="$(vless_cfg_uuid)" || { err "无法从 ${VLESS_CONFIG} 读取 uuid"; return 1; }
    sni="$(vless_cfg_sni)"   || { err "无法从 ${VLESS_CONFIG} 读取 server_name"; return 1; }
    sid="$(vless_cfg_sid)"   || { err "无法从 ${VLESS_CONFIG} 读取 short_id"; return 1; }
    if ! pub="$(vless_cfg_pubkey)"; then
        err "Reality 公钥文件缺失：${VLESS_PUBKEY_FILE}"
        err "公钥无法从配置反推，请在 VLESS 菜单重新生成密钥对。"
        return 1
    fi

    host="$(client_endpoint_host)"
    alias_enc="$(urlencode "${VLESS_ALIAS}")"
    link="vless://${uuid}@${host}:${port}?encryption=none&flow=xtls-rprx-vision&security=reality&sni=${sni}&fp=chrome&pbk=${pub}&sid=${sid}&type=tcp&headerType=none#${alias_enc}"
    link_enc="$(urlencode "${link}")"

    mkdir -p "${VLESS_DIR}"
    cat > "${VLESS_CLIENT_FILE}" <<EOF
VLESS + Reality 客户端参数
（读取自 ${VLESS_CONFIG}）
Address: ${host}
Port: ${port}
UUID: ${uuid}
Flow: xtls-rprx-vision
Encryption: none
Security: reality
SNI / server name: ${sni}
Fingerprint: chrome
Reality public key: ${pub}
Short ID: ${sid}
Network: tcp
URL: ${link}
QR: https://api.qrserver.com/v1/create-qr-code/?size=400x400&data=${link_enc}
EOF
    chmod 600 "${VLESS_CLIENT_FILE}"

    echo
    ok "VLESS + Reality 客户端参数"
    cat "${VLESS_CLIENT_FILE}"
    return 0
}

# Confirms the share link matches the running config field by field.
vless_verify_client_match() {
    local port uuid sni sid pub mismatch=0

    port="$(vless_cfg_port)" || return 1
    uuid="$(vless_cfg_uuid)" || return 1
    sni="$(vless_cfg_sni)" || return 1
    sid="$(vless_cfg_sid)" || return 1
    pub="$(vless_cfg_pubkey)" || return 1

    [ -s "${VLESS_CLIENT_FILE}" ] || return 1

    grep -q "sni=${sni}&" "${VLESS_CLIENT_FILE}" || mismatch=1
    grep -q "pbk=${pub}&" "${VLESS_CLIENT_FILE}" || mismatch=1
    grep -q "sid=${sid}&" "${VLESS_CLIENT_FILE}" || mismatch=1
    grep -q "${uuid}@" "${VLESS_CLIENT_FILE}" || mismatch=1
    grep -q ":${port}?" "${VLESS_CLIENT_FILE}" || mismatch=1
    grep -q "flow=xtls-rprx-vision" "${VLESS_CLIENT_FILE}" || mismatch=1
    grep -q "security=reality" "${VLESS_CLIENT_FILE}" || mismatch=1
    grep -q "type=tcp" "${VLESS_CLIENT_FILE}" || mismatch=1

    if [ "${mismatch}" -ne 0 ]; then
        warn "分享链接与服务端配置不一致，请在 VLESS 菜单重新生成。"
        return 1
    fi
    ok "分享链接与服务端配置一致（uuid、端口、sni、pbk、sid、flow、security、type）。"
    return 0
}

# Writes config + unit, validates, starts, verifies, then exports the link.
# Any failure aborts before "success" is printed.
vless_apply() {
    local port="$1" uuid="$2" sni="$3" priv="$4" pub="$5" sid="$6" version="$7"

    write_vless_config "${port}" "${uuid}" "${sni}" "${priv}" "${sid}"
    vless_save_public_key "${pub}"
    write_vless_service "${version}"

    sing_box_check_config "${VLESS_SING_BOX_BIN}" "${VLESS_CONFIG}" "VLESS+Reality" || return 1
    activate_and_verify "${VLESS_SERVICE_NAME}" "${port}" "VLESS+Reality" || return 1

    ok "VLESS+Reality 已在端口 ${port} 上运行。"

    # An open port only proves something is bound. Push real traffic through
    # the tunnel with the same credentials clients are given, so a Reality
    # handshake that silently rejects everyone cannot be reported as success.
    echo
    info "正在做端到端连通性验证..."
    if vless_self_test true; then
        ok "端到端验证通过。"
    else
        echo
        warn "=============================================================="
        warn "安装已完成，但端到端验证未通过。"
        warn "服务在运行、端口也开着，但用发给客户端的凭据"
        warn "实际无法通过 Reality 传输流量，客户端很可能"
        warn "同样连不上。"
        warn "请接着运行 VLESS 菜单里的「连接诊断」。"
        warn "=============================================================="
    fi

    vless_client_export || return 1
    vless_verify_client_match || true
    return 0
}

vless_install() {
    local state choice
    local port uuid sni keys priv pub sid version

    preflight_common "VLESS+Reality" || return 1

    state="$(vless_state)"
    if [ "${state}" != "not_installed" ]; then
        echo
        warn "VLESS+Reality 已安装（状态：${state}）。"
        echo "1. 保留现有 UUID、端口、密钥和 SNI，仅重装程序和服务"
        echo "2. 备份当前配置，然后全新生成"
        echo "3. 查看当前客户端配置"
        echo "0. 取消"
        read -rp "请选择 [0-3]: " choice
        case "${choice}" in
            1) vless_repair; return $? ;;
            2) vless_backup_existing ;;
            3) vless_client_export; return $? ;;
            *) info "已取消。"; return 0 ;;
        esac
    fi

    install_sing_box_binary "${VLESS_SING_BOX_BIN}" || return 1
    version="${SING_BOX_DOWNLOADED_VERSION}"

    port="$(vless_prompt_port)"
    sni="$(vless_prompt_sni)"
    uuid="$(vless_gen_uuid)" || return 1
    keys="$(vless_gen_reality_keypair)" || return 1
    priv="${keys%%|*}"
    pub="${keys#*|}"
    sid="$(vless_gen_short_id)" || return 1

    vless_apply "${port}" "${uuid}" "${sni}" "${priv}" "${pub}" "${sid}" "${version}"
}

# Rebuilds binary/unit while preserving every client-visible value.
vless_repair() {
    local port uuid sni priv pub sid version

    preflight_common "VLESS+Reality" || return 1

    if [ ! -s "${VLESS_CONFIG}" ]; then
        fail_step "VLESS+Reality repair" "No usable config at ${VLESS_CONFIG}" \
            "- Run 'Install / reinstall' and choose to generate a new config."
        return 1
    fi

    port="$(vless_cfg_port)" || { fail_step "VLESS+Reality repair" "listen_port missing from config."; return 1; }
    uuid="$(vless_cfg_uuid)" || { fail_step "VLESS+Reality repair" "uuid missing from config."; return 1; }
    sni="$(vless_cfg_sni)" || { fail_step "VLESS+Reality repair" "server_name missing from config."; return 1; }
    priv="$(vless_cfg_priv)" || { fail_step "VLESS+Reality repair" "private_key missing from config."; return 1; }
    sid="$(vless_cfg_sid)" || { fail_step "VLESS+Reality repair" "short_id missing from config."; return 1; }
    if ! pub="$(vless_cfg_pubkey)"; then
        fail_step "VLESS+Reality repair" \
            "Reality public key file ${VLESS_PUBKEY_FILE} is missing." \
            "- The public key cannot be derived from the stored private key.
- Use 'Regenerate Reality key pair' to create a fresh pair (clients must be updated)."
        return 1
    fi

    install_sing_box_binary "${VLESS_SING_BOX_BIN}" || return 1
    version="${SING_BOX_DOWNLOADED_VERSION}"

    vless_apply "${port}" "${uuid}" "${sni}" "${priv}" "${pub}" "${sid}" "${version}"
}

vless_update() {
    preflight_common "VLESS+Reality" || return 1

    if ! vless_is_installed; then
        fail_step "VLESS+Reality update" "VLESS+Reality is not installed." \
            "- Use 'Install / reinstall' first."
        return 1
    fi

    info "正在升级 sing-box，UUID、端口、密钥、SNI 保持不变。"
    vless_repair
}

# Shared path for the change-one-value actions.
vless_change_value() {
    local field="$1"
    local port uuid sni priv pub sid

    preflight_common "VLESS+Reality" || return 1

    if [ ! -s "${VLESS_CONFIG}" ] || [ ! -x "${VLESS_SING_BOX_BIN}" ]; then
        fail_step "VLESS+Reality change ${field}" "VLESS+Reality is not fully installed." \
            "- Run 'Install / reinstall' first."
        return 1
    fi

    port="$(vless_cfg_port)" || return 1
    uuid="$(vless_cfg_uuid)" || return 1
    sni="$(vless_cfg_sni)" || return 1
    priv="$(vless_cfg_priv)" || return 1
    sid="$(vless_cfg_sid)" || return 1
    pub="$(vless_cfg_pubkey)" || {
        fail_step "VLESS+Reality change ${field}" "Public key file missing: ${VLESS_PUBKEY_FILE}" \
            "- Use 'Regenerate Reality key pair' instead."
        return 1
    }

    case "${field}" in
        port)
            port="$(vless_prompt_port)"
            ;;
        uuid)
            uuid="$(vless_gen_uuid)" || return 1
            info "新的 UUID：${uuid}"
            ;;
        sni)
            sni="$(vless_prompt_sni "${sni}")"
            ;;
        keys)
            local keys
            keys="$(vless_gen_reality_keypair)" || return 1
            priv="${keys%%|*}"
            pub="${keys#*|}"
            sid="$(vless_gen_short_id)" || return 1
            warn "Reality 密钥已更换，所有客户端都必须更新 pbk/sid。"
            ;;
        *)
            fail_step "VLESS+Reality change" "Unknown field: ${field}"
            return 1
            ;;
    esac

    vless_backup_existing
    vless_apply "${port}" "${uuid}" "${sni}" "${priv}" "${pub}" "${sid}" ""
}

vless_uninstall() {
    local confirm

    require_root
    if ! vless_is_installed; then
        warn "VLESS+Reality 尚未安装。"
        return 0
    fi

    warn "只会删除本模块自己创建的文件："
    echo "  ${VLESS_DIR}"
    echo "  ${VLESS_SERVICE_FILE}"
    read -rp "确认卸载 VLESS+Reality？[y/N]: " confirm
    [[ "${confirm}" =~ ^[Yy]$ ]] || return 0

    systemctl disable --now "${VLESS_SERVICE_NAME}" 2>/dev/null || true
    rm -f "${VLESS_SERVICE_FILE}"
    rm -rf "${VLESS_DIR}"
    systemctl daemon-reload 2>/dev/null || true
    ok "VLESS+Reality 已卸载，Snell 和 AnyTLS 未受影响。"
}

vless_status() {
    local port

    if ! vless_is_installed; then
        warn "VLESS+Reality 尚未安装。"
        return 0
    fi

    echo
    ok "VLESS+Reality"
    echo "状态：$(vless_state)"
    echo "sing-box 版本：$(vless_installed_version)"
    echo "端口：$(vless_cfg_port 2>/dev/null || echo 未知)"
    echo "伪装 SNI：$(vless_cfg_sni 2>/dev/null || echo 未知)"

    if vless_is_active; then
        echo "服务：运行中"
    else
        echo "服务：已停止"
    fi

    port="$(vless_cfg_port 2>/dev/null || true)"
    if [ -n "${port}" ]; then
        port_is_listening "${port}" 1
        case "$?" in
            0) echo "端口监听：${port} 正在监听" ;;
            2) warn "端口监听：无法验证（安装 iproute2 可启用 ss 检测）" ;;
            *) warn "端口监听：端口 ${port} 上没有任何监听" ;;
        esac
    fi

    systemctl --no-pager --full status "${VLESS_SERVICE_NAME}" 2>/dev/null | sed -n '1,8p' || true
}

vless_start() {
    require_root
    vless_is_installed || { warn "VLESS+Reality 尚未安装。"; return 0; }
    systemctl start "${VLESS_SERVICE_NAME}"
    vless_status
}

vless_stop() {
    require_root
    vless_is_installed || { warn "VLESS+Reality 尚未安装。"; return 0; }
    systemctl stop "${VLESS_SERVICE_NAME}"
    vless_status
}

vless_logs() {
    journalctl -u "${VLESS_SERVICE_NAME}" --no-pager -n 80 || true
}

# Reports whether a local firewall appears to block a port. Best effort: it
# only reports what it can see and never changes any rule.
report_firewall_for_port() {
    local port="$1"
    local seen=0

    if has_command ufw && ufw status 2>/dev/null | grep -qi '^Status: active'; then
        seen=1
        if ufw status 2>/dev/null | grep -qE "(^|[[:space:]])${port}(/|[[:space:]]|$)"; then
            ok "ufw 已启用，且存在涉及端口 ${port} 的规则。"
        else
            warn "ufw 已启用，但没有涉及端口 ${port} 的规则。"
            warn "  放行命令：ufw allow ${port}/tcp"
        fi
    fi

    if has_command firewall-cmd && firewall-cmd --state >/dev/null 2>&1; then
        seen=1
        if firewall-cmd --list-ports 2>/dev/null | grep -qE "(^|[[:space:]])${port}/tcp"; then
            ok "firewalld 正在运行，端口 ${port}/tcp 已开放。"
        else
            warn "firewalld 正在运行，但端口 ${port}/tcp 不在开放列表中。"
            warn "  放行命令：firewall-cmd --add-port=${port}/tcp --permanent && firewall-cmd --reload"
        fi
    fi

    if [ "${seen}" -eq 0 ]; then
        if has_command iptables && iptables -S 2>/dev/null | grep -qE '^-P INPUT DROP'; then
            warn "iptables INPUT 默认策略为 DROP，请确认已显式放行 ${port}/tcp。"
        else
            info "本机未检测到启用的 ufw/firewalld。"
        fi
    fi

    warn "即使主机防火墙放行，云服务商的安全组仍可能拦截该端口。"
    warn "请到 VPS 控制台检查 ${port}/tcp 是否放行。"
}

# Uses this server's own sing-box as a Reality CLIENT against the running
# inbound, with the exact credentials handed to real clients. It is the one
# test that separates "the server or its credentials are wrong" from "the
# client application is misconfigured", because both ends are known-good here.
vless_self_test() {
    local quiet="${1:-false}"
    local port uuid sni pub sid local_port tmpd pid rc=0 out=""

    require_root

    if [ ! -s "${VLESS_CONFIG}" ] || [ ! -x "${VLESS_SING_BOX_BIN}" ]; then
        fail_step "VLESS+Reality self-test" "VLESS+Reality is not fully installed."
        return 1
    fi
    if ! service_is_active "${VLESS_SERVICE_NAME}"; then
        fail_step "VLESS+Reality self-test" "${VLESS_SERVICE_NAME} is not running." \
            "- Start it first from the VLESS menu."
        return 1
    fi

    port="$(vless_cfg_port)"   || { fail_step "self-test" "Cannot read the port."; return 1; }
    uuid="$(vless_cfg_uuid)"   || { fail_step "self-test" "Cannot read the uuid."; return 1; }
    sni="$(vless_cfg_sni)"     || { fail_step "self-test" "Cannot read the SNI."; return 1; }
    sid="$(vless_cfg_sid)"     || { fail_step "self-test" "Cannot read the short id."; return 1; }
    pub="$(vless_cfg_pubkey)"  || { fail_step "self-test" "Cannot read the public key."; return 1; }

    local_port="$(random_available_port)"
    tmpd="$(mktemp -d)"

    # A client config built from exactly what real clients are told to use.
    cat > "${tmpd}/client.json" <<EOF
{
  "log": { "level": "warn" },
  "inbounds": [
    {
      "type": "socks",
      "tag": "socks-in",
      "listen": "127.0.0.1",
      "listen_port": ${local_port}
    }
  ],
  "outbounds": [
    {
      "type": "vless",
      "tag": "vless-out",
      "server": "127.0.0.1",
      "server_port": ${port},
      "uuid": "${uuid}",
      "flow": "xtls-rprx-vision",
      "tls": {
        "enabled": true,
        "server_name": "${sni}",
        "utls": { "enabled": true, "fingerprint": "chrome" },
        "reality": {
          "enabled": true,
          "public_key": "${pub}",
          "short_id": "${sid}"
        }
      }
    }
  ]
}
EOF

    echo
    info "=== VLESS+Reality 服务器自测 ==="
    echo "用发给客户端的同一套凭据，从本机连接本机的入站。"

    if ! "${VLESS_SING_BOX_BIN}" check -c "${tmpd}/client.json" >/dev/null 2>&1; then
        err "生成的测试客户端配置被 sing-box 拒绝："
        "${VLESS_SING_BOX_BIN}" check -c "${tmpd}/client.json" 2>&1 | sed 's/^/  /' >&2 || true
        rm -rf "${tmpd}"
        return 1
    fi

    "${VLESS_SING_BOX_BIN}" run -c "${tmpd}/client.json" >"${tmpd}/client.log" 2>&1 &
    pid=$!
    sleep 3

    if ! kill -0 "${pid}" 2>/dev/null; then
        err "测试客户端立即退出："
        sed 's/^/  /' "${tmpd}/client.log" >&2 || true
        rm -rf "${tmpd}"
        return 1
    fi

    out="$(curl -s --max-time 20 --socks5-hostname "127.0.0.1:${local_port}" \
        https://www.cloudflare.com/cdn-cgi/trace 2>&1)" || rc=$?

    kill "${pid}" 2>/dev/null || true
    wait "${pid}" 2>/dev/null || true

    echo
    if [ "${rc}" -eq 0 ] && printf '%s' "${out}" | grep -q '^ip='; then
        ok "自测通过：流量已成功通过 Reality 传输。"
        echo "   目标网站看到的出口 IP："
        printf '%s\n' "${out}" | grep -E '^(ip|loc)=' | sed 's/^/     /'
        if [ "${quiet}" != "true" ]; then
            echo
            ok "服务端、凭据、Reality 握手全部正常。"
            warn "因此问题出在客户端配置上。"
            warn "请用菜单选项 3 的分享链接，重新导入到支持"
            warn "Reality + xtls-rprx-vision 的客户端，并先删除旧节点。"
        fi
        rm -rf "${tmpd}"
        return 0
    fi

    err "自测失败：流量无法通过 Reality 传输。"
    [ -n "${out}" ] && printf '   curl: %s\n' "${out}" >&2
    if [ -s "${tmpd}/client.log" ]; then
        err "   测试客户端日志："
        sed 's/^/     /' "${tmpd}/client.log" >&2
    fi
    warn "   两端都是本脚本生成的，因此问题在服务端。"
    warn "   请运行「连接诊断」查看逐项排查结果。"
    rm -rf "${tmpd}"
    return 1
}

# Streams this service's log while the operator makes a real connection
# attempt, so a current failure can be told apart from a stale log entry and
# the exact rejection reason is seen as it happens.
vless_watch_live() {
    local seconds="${1:-60}"

    require_root
    if ! vless_is_installed; then
        warn "VLESS+Reality 尚未安装。"
        return 0
    fi

    echo
    info "正在监听 ${VLESS_SERVICE_NAME} 日志，共 ${seconds} 秒。"
    warn "请立刻打开客户端尝试连接。"
    echo
    echo "如何看结果："
    echo "  出现 'REALITY: processed invalid connection'"
    echo "      → 客户端连到了服务器，但 Reality 认证失败。"
    echo "         pbk / sid / sni 对不上，请重新导入分享链接。"
    echo "  完全没有输出"
    echo "      → 流量根本没到本机。请检查云服务商安全组，"
    echo "         或客户端连的地址/端口不对。"
    echo "  出现 'inbound connection' 且无报错"
    echo "      → 认证已成功，问题在认证之后的路由。"
    echo
    info "--- 实时日志（到时自动停止）---"

    timeout "${seconds}" journalctl -u "${VLESS_SERVICE_NAME}" -f --since now --no-pager 2>/dev/null || true

    echo
    info "--- 观察结束 ---"
    return 0
}

# Distinguishes the failure modes that look identical from a client:
# port unreachable, Reality handshake target unreachable, clock skew, or a
# client-side flow/parameter mismatch.
vless_diagnose() {
    local port sni uuid sid pub host problems=0
    local tls_out=""

    require_root

    if [ ! -s "${VLESS_CONFIG}" ]; then
        fail_step "VLESS+Reality diagnosis" "No config at ${VLESS_CONFIG}" \
            "- Install VLESS+Reality first."
        return 1
    fi

    port="$(vless_cfg_port 2>/dev/null || true)"
    sni="$(vless_cfg_sni 2>/dev/null || true)"
    uuid="$(vless_cfg_uuid 2>/dev/null || true)"
    sid="$(vless_cfg_sid 2>/dev/null || true)"
    pub="$(vless_cfg_pubkey 2>/dev/null || true)"

    echo
    info "=== VLESS+Reality 连接诊断 ==="

    # 1. Service
    if service_is_active "${VLESS_SERVICE_NAME}"; then
        ok "1. 服务 ${VLESS_SERVICE_NAME} 正在运行。"
    else
        err "1. 服务 ${VLESS_SERVICE_NAME} 未运行。"
        problems=$((problems + 1))
        journalctl -u "${VLESS_SERVICE_NAME}" --no-pager -n 20 >&2 || true
    fi

    # 1b. Staleness. A process started before the current config keeps serving
    #     the old keys, so the file validates while every client is rejected.
    local running_cfg
    if service_config_is_stale "${VLESS_SERVICE_NAME}" "${VLESS_CONFIG}"; then
        err "1b. 运行中的服务比 ${VLESS_CONFIG} 旧。"
        err "    它仍在用旧密钥，因此当前分享链接无法通过认证，"
        err "    这本身就足以导致 invalid connection。"
        warn "    立即修复：systemctl restart ${VLESS_SERVICE_NAME}"
        warn "    （或使用 VLESS 菜单里的「修复安装」）"
        problems=$((problems + 1))
    else
        case "$?" in
            1) ok "1b. 运行中的服务与当前配置文件一致。" ;;
            *) warn "1b. 无法判断运行中的服务是否为最新配置。" ;;
        esac
    fi

    running_cfg="$(service_running_config_path "${VLESS_SERVICE_NAME}" 2>/dev/null || true)"
    if [ -n "${running_cfg}" ] && [ "${running_cfg}" != "${VLESS_CONFIG}" ]; then
        err "    运行中的进程加载的是另一个配置文件："
        err "      running: ${running_cfg}"
        err "      managed: ${VLESS_CONFIG}"
        problems=$((problems + 1))
    fi

    # 2. Config accepted by this sing-box build
    if [ -x "${VLESS_SING_BOX_BIN}" ]; then
        if "${VLESS_SING_BOX_BIN}" check -c "${VLESS_CONFIG}" >/dev/null 2>&1; then
            ok "2. sing-box 接受该配置。"
        else
            err "2. sing-box 拒绝该配置："
            "${VLESS_SING_BOX_BIN}" check -c "${VLESS_CONFIG}" 2>&1 | sed 's/^/     /' >&2 || true
            problems=$((problems + 1))
        fi
    else
        err "2. sing-box 程序缺失：${VLESS_SING_BOX_BIN}"
        problems=$((problems + 1))
    fi

    # 3. Listener
    port_is_listening "${port}" 1
    case "$?" in
        0)
            ok "3. 端口 ${port} 正在本机监听。"
            if has_command ss; then
                ss -tlnp 2>/dev/null | awk -v p=":${port}" '$4 ~ p {print "     " $0}' >&2 || true
            fi
            ;;
        2)
            warn "3. 无法验证端口监听：本机没有 ss/netstat/lsof。"
            warn "   安装 iproute2 可启用该检查。"
            ;;
        *)
            err "3. 端口 ${port} 上没有任何监听。"
            problems=$((problems + 1))
            ;;
    esac

    # 4. Firewall / security group
    echo
    info "4. 端口 ${port} 的防火墙检查"
    report_firewall_for_port "${port}"

    # 5. Reality handshake target reachability -- the check that matters most
    #    here, and the one AnyTLS never needs.
    echo
    info "5. Reality 伪装目标：${sni}"
    if has_command timeout && has_command openssl; then
        tls_out="$(timeout 10 openssl s_client -connect "${sni}:443" -servername "${sni}" </dev/null 2>&1 || true)"
        if printf '%s' "${tls_out}" | grep -q "CONNECTED"; then
            ok "   本机可以访问 ${sni}:443"
            if printf '%s' "${tls_out}" | grep -qE "Protocol *: *TLSv1\.3|TLSv1\.3"; then
                ok "   ${sni} 支持 TLS 1.3。"
            else
                err "   ${sni} 不支持 TLS 1.3，Reality 要求目标支持 TLS 1.3。"
                warn "   请在 VLESS 菜单里用「修改伪装域名 SNI」更换。"
                problems=$((problems + 1))
            fi

            # X25519 is a separate, equally hard requirement. A target can pass
            # every other check and still break every Reality handshake here.
            reality_target_is_suitable "${sni}"
            case "$?" in
                0) ok "   ${sni} 支持 X25519 密钥交换（Reality 必需）。" ;;
                2) warn "   无法检测 ${sni} 的 X25519 支持情况。" ;;
                *)
                    err "   ${sni} 不支持 TLS 1.3 + X25519 密钥交换。"
                    err "   Reality 强制要求这一点，否则每次握手都会失败，"
                    err "   这正是你看到的 processed invalid connection。"
                    warn "   修复：VLESS 菜单 →「修改伪装域名 SNI」→ 直接回车"
                    warn "   自动挑选一个本机实测可用的站点。"
                    problems=$((problems + 1))
                    ;;
            esac
        else
            err "   本机无法访问 ${sni}:443"
            err "   Reality 需要把 TLS 握手转发给该站点，因此无法工作。"
            warn "   请在 VLESS 菜单里改成本机能访问的站点："
            warn "   「修改伪装域名 SNI（握手目标站点）」。"
            problems=$((problems + 1))
        fi
    else
        warn "   已跳过：缺少 openssl 或 timeout。"
    fi

    # 6. Clock: Reality rejects handshakes outside a tolerance window.
    echo
    info "6. 系统时钟"
    echo "   UTC now: $(date -u)"
    if has_command timedatectl; then
        if timedatectl show -p NTPSynchronized --value 2>/dev/null | grep -q '^yes$'; then
            ok "   时钟已与 NTP 同步。"
        else
            warn "   时钟未与 NTP 同步，Reality 对时间敏感。"
            warn "   修复：timedatectl set-ntp true"
        fi
    fi

    # 6b. Reality credential integrity. "processed invalid connection" in the
    #     log means the client failed Reality authentication, so verify the
    #     advertised public key really derives from the server's private key.
    echo
    info "6b. Reality 凭据"
    local priv derived
    priv="$(vless_cfg_priv 2>/dev/null || true)"

    if [ "${#pub}" -eq 43 ] && [[ "${pub}" =~ ^[A-Za-z0-9_-]{43}$ ]]; then
        ok "   公钥格式正确（43 位 base64url）。"
    else
        err "   公钥格式异常：${pub}（${#pub} 位，应为 43 位）。"
        problems=$((problems + 1))
    fi

    if [[ "${sid}" =~ ^([0-9a-f]{2}){1,8}$ ]]; then
        ok "   Short ID 格式正确（${sid}）。"
    else
        err "   Short ID 格式异常：${sid}（应为 2-16 位十六进制）。"
        problems=$((problems + 1))
    fi

    if [ -n "${priv}" ] && derived="$(vless_derive_reality_public_key "${priv}")"; then
        if [ "${derived}" = "${pub}" ]; then
            ok "   公钥与服务器私钥匹配。"
        else
            err "   不匹配：保存的公钥不属于当前私钥。"
            err "     已保存：${pub}"
            err "     实际应为：${derived}"
            warn "   使用旧公钥的客户端永远无法认证成功。"
            warn "   请把上面「实际应为」的公钥给客户端，或用 VLESS 菜单"
            warn "   里的「重新生成 Reality 密钥对」。"
            problems=$((problems + 1))
        fi
    else
        warn "   无法在本机推导公钥，已跳过该检查。"
    fi

    if journalctl -u "${VLESS_SERVICE_NAME}" --no-pager -n 500 2>/dev/null \
        | grep -q "REALITY: processed invalid connection"; then
        echo
        warn "   日志出现 REALITY: processed invalid connection。"
        warn "   说明客户端已连到本机但 Reality 认证失败，"
        warn "   因此网络、端口、防火墙都没问题。"
        warn "   请用菜单选项 3 复制完整分享链接，不要手抄公钥："
        warn "   pbk 或 sid 少一个字符就会导致完全相同的报错。"
        warn ""
    fi

    # 7. Effective client parameters
    echo
    info "7. 客户端必须与以下参数完全一致"
    host="$(client_endpoint_host)"
    echo "   address    : ${host}"
    echo "   port       : ${port}"
    echo "   uuid       : ${uuid}"
    echo "   flow       : xtls-rprx-vision"
    echo "   security   : reality"
    echo "   sni        : ${sni}"
    echo "   fingerprint: chrome"
    echo "   publicKey  : ${pub}"
    echo "   shortId    : ${sid}"
    echo "   network    : tcp"
    warn "   Reality 必须关闭「跳过证书验证 / allow insecure」。"
    warn "   客户端必须支持 Reality + xtls-rprx-vision。若能连上"
    warn "   但没有流量，通常是 flow 不支持或未设置。"

    # 8. Errors, with an explicit age so stale entries are not mistaken for a
    #    live failure.
    echo
    info "8. 服务报错"
    local since_start recent_count old_count
    since_start="$(systemctl show "${VLESS_SERVICE_NAME}" -p ActiveEnterTimestamp --value 2>/dev/null || true)"
    [ -n "${since_start}" ] && echo "   服务启动时间：${since_start}"

    recent_count="$(journalctl -u "${VLESS_SERVICE_NAME}" --no-pager --since '-5 min' 2>/dev/null \
        | grep -ciE "error|fatal|reject|refused" || true)"
    old_count="$(journalctl -u "${VLESS_SERVICE_NAME}" --no-pager -n 500 2>/dev/null \
        | grep -ciE "error|fatal|reject|refused" || true)"

    if [ "${recent_count:-0}" -gt 0 ]; then
        err "   最近 5 分钟内有 ${recent_count} 条报错 —— 问题正在发生："
        journalctl -u "${VLESS_SERVICE_NAME}" --no-pager --since '-5 min' 2>/dev/null \
            | grep -iE "error|fatal|reject|refused" | tail -n 5 | sed 's/^/     /'
    elif [ "${old_count:-0}" -gt 0 ]; then
        warn "   最近 5 分钟无报错，但有 ${old_count} 条更早的记录。"
        warn "   可能是历史残留。请用「实时观察连接」现场测试。"
        journalctl -u "${VLESS_SERVICE_NAME}" --no-pager -n 500 2>/dev/null \
            | grep -iE "error|fatal|reject|refused" | tail -n 3 | sed 's/^/     /'
    else
        ok "   未发现报错。"
    fi

    echo
    if [ "${problems}" -eq 0 ]; then
        ok "未发现服务端问题。请重点核对第 7 项的客户端参数，"
        ok "以及云服务商安全组是否放行了端口 ${port}。"
    else
        err "发现 ${problems} 处服务端问题，请修复上面标红的项。"
    fi
    return 0
}

