# Runs the three protocol installs in sequence. A failing module is reported
# and recorded, but does not abort the remaining protocols; the summary at the
# end states exactly what succeeded and what did not.
deploy_stack() {
    local with_cert="$1"
    local with_bbr="$2"
    local method=""
    local total=3
    local step=0
    local failed=()

    require_root

    [ "${with_bbr}" = "true" ] && total=4

    if [ "${with_cert}" = "true" ]; then
        echo
        info "本次部署 AnyTLS 使用的证书方式："
        echo "1. 用 HTTP-01 申请新证书（需要 80 端口可达）"
        echo "2. 用 Cloudflare DNS-01 申请新证书（不需要 80 端口）"
        echo "3. 使用本机已申请过的证书"
        read -rp "请选择证书申请方式 [1-3]: " method
        case "${method}" in
            1|2|3) : ;;
            *) err "无效选项。"; return 1 ;;
        esac
    fi

    if [ "${with_bbr}" = "true" ]; then
        step=$((step + 1))
        info "第 ${step}/${total} 步：开启 BBR"
        enable_bbr || failed+=("BBR")
        echo
    fi

    step=$((step + 1))
    info "第 ${step}/${total} 步：安装 Snell"
    install_snell || failed+=("Snell")
    echo

    step=$((step + 1))
    info "第 ${step}/${total} 步：安装 VLESS+Reality"
    info "Reality 借用第三方站点的 TLS 握手，无需域名和证书。"
    vless_install || failed+=("VLESS+Reality")
    echo

    step=$((step + 1))
    if [ "${with_cert}" = "true" ]; then
        info "第 ${step}/${total} 步：安装 AnyTLS（使用你的域名证书）"
        case "${method}" in
            1) anytls_install_with_acme_cert || failed+=("AnyTLS") ;;
            2) anytls_install_with_cloudflare_cert || failed+=("AnyTLS") ;;
            3) anytls_apply_existing_cert || failed+=("AnyTLS") ;;
        esac
    else
        info "第 ${step}/${total} 步：安装 AnyTLS（自签证书）"
        anytls_install_self_signed || failed+=("AnyTLS")
    fi

    echo
    if [ "${#failed[@]}" -eq 0 ]; then
        ok "所选组件已全部安装成功。"
        return 0
    fi

    err "以下组件失败：${failed[*]}"
    warn "其余组件已正常安装。可单独进入对应菜单重跑失败项，"
    warn "以查看具体报错。"
    return 1
}

deploy_three_no_cert()            { deploy_stack "false" "false"; }
deploy_three_with_domain_cert()   { deploy_stack "true"  "false"; }
deploy_bbr_three_with_domain_cert() { deploy_stack "true" "true"; }

restart_proxy_services() {
    require_root

    info "仅重启 Snell、VLESS+Reality、AnyTLS 三个服务，不会改动 BBR。"

    if [ -f "${SERVICE_FILE}" ]; then
        activate_and_verify "snell" "$(snell_main_port)" "Snell" || true
    else
        warn "未找到 Snell 服务文件，已跳过。"
    fi

    if [ -f "${VLESS_SERVICE_FILE}" ]; then
        activate_and_verify "${VLESS_SERVICE_NAME}" "$(vless_cfg_port 2>/dev/null || true)" "VLESS+Reality" || true
    else
        warn "未找到 VLESS+Reality 服务文件，已跳过。"
    fi

    if [ -f "${ANYTLS_SERVICE_FILE}" ]; then
        activate_and_verify "${ANYTLS_SERVICE_NAME}" "$(anytls_cfg_port 2>/dev/null || true)" "AnyTLS" || true
    else
        warn "未找到 AnyTLS 服务文件，已跳过。"
    fi

    echo
    show_bbr_status
}

add_user() {
    local port
    local dns
    local psk
    local file

    require_root
    ensure_dirs

    port="$(prompt_port random)"
    file="${USERS_DIR}/snell-${port}.conf"
    [ ! -f "${file}" ] || die "Config already exists for port ${port}: ${file}"

    dns="$(prompt_dns)"
    psk="$(random_psk)"
    write_config "${file}" "${port}" "${psk}" "${dns}"
    ok "Created config: ${file}"
    warn "The default snell.service loads only ${MAIN_CONF}. Create a separate service if you need multiple live ports."
}

remove_user() {
    local port
    local file
    local confirm

    require_root

    read -rp "Additional user port to remove: " port
    [[ "${port}" =~ ^[0-9]+$ ]] || die "Invalid port."
    file="${USERS_DIR}/snell-${port}.conf"

    [ -f "${file}" ] || die "Config not found: ${file}"

    read -rp "Remove ${file}? [y/N]: " confirm
    [[ "${confirm}" =~ ^[Yy]$ ]] || return 0
    rm -f "${file}"
    ok "Removed: ${file}"
}

